# Dockerfile.build-runner — Chromium build runner image (T112).
#
# Built and pushed to registry.triform.cloud/chromeless/chromeless-build-runner.
# Pulled by build-job.yaml.
#
# What this image bundles:
#   - depot_tools (gclient, gn, autoninja, git-cl). Pinned at build
#     time to a specific revision; auto-update suppressed at runtime
#     via DEPOT_TOOLS_UPDATE=0 so the runner is reproducible.
#   - sccache release binary, pinned. chromeless-build.sh (T113) sets
#     CC_WRAPPER + RUSTC_WRAPPER to point at it.
#   - python3 + git + build-essential + lsb-release + sudo: the
#     bare minimum so `install-build-deps.sh` (run by chromeless-build.sh
#     inside the Chromium tree on first sync) can self-bootstrap
#     the rest of the apt deps.
#
# What this image deliberately does NOT install:
#   - The Chromium build apt deps. Those come from
#     `build/install-build-deps.sh` inside the Chromium tree on first
#     run, because the dep set rotates per Chromium branch and we
#     want the runner image to be branch-agnostic.
#
# Build:
#   docker build -t registry.triform.cloud/chromeless/chromeless-build-runner:0.1.0 \
#                -f infra/k8s/chromeless-build/Dockerfile.build-runner \
#                infra/k8s/chromeless-build/
#   docker push registry.triform.cloud/chromeless/chromeless-build-runner:0.1.0
#
# (See README.md for the full registry push step including auth.)

# Debian 12 (bookworm) matches the canonical Chromium build host per
# T17 §4. Also matches the runtime infra/Dockerfile, so any host-side
# binary we extract will libc-link cleanly to the runtime container.
FROM debian:bookworm-slim

# Avoid noisy tty prompts during apt; keep frontend non-interactive
# for the whole image. unset DEBIAN_FRONTEND in chromeless-build.sh if a sub-
# command needs to prompt.
ENV DEBIAN_FRONTEND=noninteractive

# Versions captured here so the image is reproducible. Bump in lockstep
# with the Chromium roll.
ARG SCCACHE_VERSION=v0.8.2
# Pinned depot_tools commit. Update by checking out a specific
# revision; no version tags exist on depot_tools so we use a hash.
# See chromium.googlesource.com/chromium/tools/depot_tools.
ARG DEPOT_TOOLS_REF=main

# hadolint ignore=DL3008
# Phase 0 of the build env: track Debian's package versions so security
# updates flow without pin-thrashing. Lock down once we have a
# regular roll cadence (T17 §6 phase 2).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        python3 \
        python3-pip \
        build-essential \
        pkg-config \
        sudo \
        lsb-release \
        file \
        xz-utils \
        zstd \
        rsync \
        findutils \
        libglib2.0-0 \
        gperf \
        bison \
        flex \
    && rm -rf /var/lib/apt/lists/*

# depot_tools at /opt/depot_tools. Pinning happens by `git checkout`
# rather than by URL so we keep the upstream tree intact for rare
# git-cl operations. DEPOT_TOOLS_UPDATE=0 (set in ENV below) prevents
# auto-updates inside the container.
RUN git clone --depth 200 \
      https://chromium.googlesource.com/chromium/tools/depot_tools.git \
      /opt/depot_tools \
    && cd /opt/depot_tools \
    && git checkout "${DEPOT_TOOLS_REF}"

# sccache: musl release tarball from upstream. Verified by extracting
# to a tmp dir and installing only the binary; no install scripts run.
RUN curl -fSL "https://github.com/mozilla/sccache/releases/download/${SCCACHE_VERSION}/sccache-${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
      -o /tmp/sccache.tar.gz \
    && tar -xzf /tmp/sccache.tar.gz -C /tmp \
    && install -m 0755 \
        "/tmp/sccache-${SCCACHE_VERSION}-x86_64-unknown-linux-musl/sccache" \
        /usr/local/bin/sccache \
    && rm -rf /tmp/sccache.tar.gz "/tmp/sccache-${SCCACHE_VERSION}-x86_64-unknown-linux-musl"

# A non-root user is required by `install-build-deps.sh`; the script
# rejects root on purpose (apt invocations inside it use sudo). We
# grant passwordless sudo because the runner is single-purpose and
# already pinned to a non-shared node — there's no privilege boundary
# inside the image to defend.
RUN useradd -m -u 1000 -s /bin/bash builder \
    && echo 'builder ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/builder \
    && chmod 0440 /etc/sudoers.d/builder

# Pre-create /work with the right ownership so runtime PVC mounts at
# /work/src and /sccache work without a chown step in chromeless-build.sh.
# K8s PVC mount inherits the volume's ownership at first; chown'd
# once by the bootstrap initContainer in build-job.yaml.
RUN mkdir -p /work /sccache /home/builder/.cache \
    && chown -R builder:builder /work /sccache /home/builder/.cache

USER builder
WORKDIR /work

# PATH: depot_tools first so its `gn`, `autoninja`, `gclient` win
# over any Debian-shipped versions; sccache is on /usr/local/bin
# which is already on PATH.
ENV PATH=/opt/depot_tools:/usr/local/bin:/usr/bin:/bin
ENV DEPOT_TOOLS_UPDATE=0

# Sccache hints. chromeless-build.sh (T113) sets CC_WRAPPER via args.gn but
# also reads SCCACHE_DIR + SCCACHE_CACHE_SIZE if set. We export sane
# defaults; the Job overrides as needed.
ENV SCCACHE_DIR=/sccache
ENV SCCACHE_CACHE_SIZE=80G
# Idle-timeout 0 keeps the sccache server alive for the full build
# (it forks one server per shell otherwise).
ENV SCCACHE_IDLE_TIMEOUT=0

# Default entrypoint is `bash` so kubectl exec lands in a usable
# shell when the Job has stalled. The Job's command/args explicitly
# invoke /work/src/build/chromeless-build.sh (T113's contract).
CMD ["bash"]
