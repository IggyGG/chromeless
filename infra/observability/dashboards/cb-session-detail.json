{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-session drill-down for one cloud-browser-webrtc chromium pod / sidecar. Pick `$instance` for the sidecar process and `$session_id` (T82) for the per-session client metrics. `$tenant_id` (T82) is exposed for multi-tenant filtering.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Cluster overview",
      "type": "dashboards",
      "tags": [
        "cloud-browser-webrtc"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "View traces in Jaeger",
      "type": "link",
      "url": "/explore?orgId=1&left=%7B%22datasource%22:%22jaeger%22,%22queries%22:%5B%7B%22query%22:%22cb-client%22,%22tags%22:%22session.id=$session_id%22%7D%5D%7D",
      "tooltip": "Open Jaeger explore filtered to this session's traces. Requires a Jaeger or Tempo datasource named 'jaeger'; see docs/operations/tracing.md.",
      "icon": "external link",
      "targetBlank": true,
      "keepTime": true
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Outbound RTP bitrate by track kind for this session.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30
          },
          "unit": "bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_webrtc_outbound_bitrate_bps{instance=~\"$instance\",region=~\"$region\"}",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "title": "Outbound bitrate (per kind)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Encoder fps and dropped-frame rate. A widening gap between fps target (typically 30) and rate is a quality red flag.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_webrtc_outbound_frames_per_second{instance=~\"$instance\",region=~\"$region\"}",
          "legendFormat": "fps",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cb_webrtc_outbound_dropped_frames_total{instance=~\"$instance\",region=~\"$region\"}[1m])",
          "legendFormat": "dropped/s",
          "refId": "B"
        }
      ],
      "title": "Encoder fps + dropped frames",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Average video encoder QP. Lower = higher quality; sustained >38 with bitrate at ceiling means encoder saturation.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "orange",
                "value": 38
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg(cb_webrtc_outbound_qp{instance=~\"$instance\",region=~\"$region\"})",
          "legendFormat": "qp",
          "refId": "A"
        }
      ],
      "title": "Encoder QP",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Selected ICE candidate-pair RTT. Single best leading indicator of perceived interactivity. v1 LAN target <100 ms; regional <200 ms.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "orange",
                "value": 200
              },
              {
                "color": "red",
                "value": 400
              }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_webrtc_round_trip_time_ms{instance=~\"$instance\",region=~\"$region\"}",
          "legendFormat": "rtt",
          "refId": "A"
        }
      ],
      "title": "ICE RTT",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Packets the remote peer reported as lost. Steady state should be near zero; spikes correlate with the user's network deterioration.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cb_webrtc_remote_inbound_packets_lost_total{instance=~\"$instance\",region=~\"$region\"}[1m])",
          "legendFormat": "lost/s",
          "refId": "A"
        }
      ],
      "title": "Remote inbound packet loss (1m rate)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Aggregate Chromium CPU as a percent of one core. >100% means multiple cores are busy. Cross-correlate with QP and dropped frames for encoder-saturation diagnosis.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_chromium_cpu_pct{instance=~\"$instance\",region=~\"$region\"}",
          "legendFormat": "cpu%",
          "refId": "A"
        }
      ],
      "title": "Chromium CPU%",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Aggregate Chromium RSS across all helper processes. Watch for unbounded growth \u2014 leak indicator.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30
          },
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_chromium_rss_bytes{instance=~\"$instance\",region=~\"$region\"}",
          "legendFormat": "rss",
          "refId": "A"
        }
      ],
      "title": "Chromium RSS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Encoder limitation reasons over time. The metric is reserved for a future T38 enhancement (qualityLimitationReason from getStats() \u2014 values: none, cpu, bandwidth, other). Empty until that lands.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_webrtc_quality_limitation_fraction{instance=~\"$instance\",region=~\"$region\"}",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Encoder quality limitation reasons (reserved; empty until T38 follow-up)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "T72: Outbound video bitrate (what the streamer sent) overlaid with the client's observed inbound video bitrate (what the user's browser actually received). A persistent gap between the two is the network drop signal \u2014 see infra/observability.md.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_webrtc_outbound_bitrate_bps{kind=\"video\",instance=~\"$instance\",region=~\"$region\"}",
          "legendFormat": "outbound (server sent)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_client_inbound_video_bitrate_bps{instance=~\"$instance\",tenant_id=~\"$tenant_id\",session_id=~\"$session_id\",region=~\"$region\"}",
          "legendFormat": "inbound (client got)",
          "refId": "B"
        }
      ],
      "title": "Video bitrate \u2014 sent vs. received (T72)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "T72: client-observed RTT vs. server-observed RTT. Should agree to within sample-time jitter; persistent divergence == clock skew or NAT rebinding.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_webrtc_round_trip_time_ms{instance=~\"$instance\",region=~\"$region\"}",
          "legendFormat": "server-observed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_client_pair_rtt_ms{instance=~\"$instance\",tenant_id=~\"$tenant_id\",session_id=~\"$session_id\",region=~\"$region\"}",
          "legendFormat": "client-observed",
          "refId": "B"
        }
      ],
      "title": "ICE RTT \u2014 server vs. client (T72)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "T72: client-side video FPS, dropped frames rate, and remote-inbound packet loss fraction. Lower-right loss-fraction is the leading indicator of upcoming connection trouble.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_client_inbound_video_fps{instance=~\"$instance\",tenant_id=~\"$tenant_id\",session_id=~\"$session_id\",region=~\"$region\"}",
          "legendFormat": "client fps",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(cb_client_inbound_video_frames_dropped_total{instance=~\"$instance\",tenant_id=~\"$tenant_id\",session_id=~\"$session_id\",region=~\"$region\"}[1m])",
          "legendFormat": "client dropped fps",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "cb_client_remote_inbound_packet_loss_fraction{instance=~\"$instance\",tenant_id=~\"$tenant_id\",session_id=~\"$session_id\",region=~\"$region\"} * 100",
          "legendFormat": "remote-inbound loss %",
          "refId": "C"
        }
      ],
      "title": "Client-side health \u2014 FPS / dropped / loss (T72)",
      "type": "timeseries"
    }
  ],
