        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "cloud-browser-webrtc — session detail",
  "uid": "cb-session-detail",
  "version": 1,
  "weekStart": ""
}
