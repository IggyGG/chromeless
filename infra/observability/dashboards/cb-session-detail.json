{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-session drill-down for one cloud-browser-webrtc chromium pod / sidecar. Use the $instance variable to pick which sidecar's metrics to render. Once the session controller (T50) lands a session_id label, this dashboard pivots to $session_id.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Cluster overview",
      "type": "dashboards",
      "tags": ["cloud-browser-webrtc"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Outbound RTP bitrate by track kind for this session.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 30},
          "unit": "bps"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "cb_webrtc_outbound_bitrate_bps{instance=~\"$instance\"}",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "title": "Outbound bitrate (per kind)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Encoder fps and dropped-frame rate. A widening gap between fps target (typically 30) and rate is a quality red flag.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10},
          "unit": "none"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "cb_webrtc_outbound_frames_per_second{instance=~\"$instance\"}",
          "legendFormat": "fps",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(cb_webrtc_outbound_dropped_frames_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "dropped/s",
          "refId": "B"
        }
      ],
      "title": "Encoder fps + dropped frames",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Average video encoder QP. Lower = higher quality; sustained >38 with bitrate at ceiling means encoder saturation.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 30},
              {"color": "orange", "value": 38},
              {"color": "red", "value": 50}
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "avg(cb_webrtc_outbound_qp{instance=~\"$instance\"})",
          "legendFormat": "qp",
          "refId": "A"
        }
      ],
      "title": "Encoder QP",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Selected ICE candidate-pair RTT. Single best leading indicator of perceived interactivity. v1 LAN target <100 ms; regional <200 ms.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "orange", "value": 200},
              {"color": "red", "value": 400}
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "cb_webrtc_round_trip_time_ms{instance=~\"$instance\"}",
          "legendFormat": "rtt",
          "refId": "A"
        }
      ],
      "title": "ICE RTT",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Packets the remote peer reported as lost. Steady state should be near zero; spikes correlate with the user's network deterioration.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10},
          "unit": "ops"
        }
      },
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(cb_webrtc_remote_inbound_packets_lost_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "lost/s",
          "refId": "A"
        }
      ],
      "title": "Remote inbound packet loss (1m rate)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Aggregate Chromium CPU as a percent of one core. >100% means multiple cores are busy. Cross-correlate with QP and dropped frames for encoder-saturation diagnosis.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 30},
          "unit": "percent"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "cb_chromium_cpu_pct{instance=~\"$instance\"}",
          "legendFormat": "cpu%",
          "refId": "A"
        }
      ],
      "title": "Chromium CPU%",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Aggregate Chromium RSS across all helper processes. Watch for unbounded growth — leak indicator.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 30},
          "unit": "bytes"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "cb_chromium_rss_bytes{instance=~\"$instance\"}",
          "legendFormat": "rss",
          "refId": "A"
        }
      ],
      "title": "Chromium RSS",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Encoder limitation reasons over time. The metric is reserved for a future T38 enhancement (qualityLimitationReason from getStats() — values: none, cpu, bandwidth, other). Empty until that lands.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 80, "stacking": {"mode": "normal"}},
          "unit": "percent"
        }
      },
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 22},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "cb_webrtc_quality_limitation_fraction{instance=~\"$instance\"}",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Encoder quality limitation reasons (reserved; empty until T38 follow-up)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["cloud-browser-webrtc"],
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"},
