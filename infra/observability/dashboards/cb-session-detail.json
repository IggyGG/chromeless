        "definition": "label_values(cb_chromium_cpu_pct, instance)",
        "description": "Pick a sidecar instance. Once the session controller (T50) tags metrics with session_id, this dashboard will switch to a $session_id variable.",
        "hide": 0,
        "includeAll": true,
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": {
          "query": "label_values(cb_chromium_cpu_pct, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
