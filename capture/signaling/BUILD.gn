#
# gn targets for the cb-chromium ↔ physics signaling client.
#
# # Module decomposition (CV2-50 .. CV2-54, M3)
#
#   R1 (:cb_wire_envelope) — pure codec: typed envelope struct + JSON
#       encode/decode for the six source-pinned tags. No I/O, no
#       threading. Linkable on its own so tests don't drag in the
#       chromium net stack.
#   R2 (:cb_signaling_ws_client) — native WebSocket client (rides on
#       //services/network's NetworkContext::CreateWebSocket Mojo
#       interface).
#   R3 (:cb_ice_config) — env-driven ICE-server loader.
#   R4 (:cb_offerer_driver) — offerer handshake driver (SDP+ICE dance).
#   R5 (:cb_dc_host) — DataChannel host: owns the five outbound DCs
#       (input, stats, cursor, clipboard, file-upload) created on R4's
#       PeerConnection; provides observer-binding + Send() API for the
#       M4/M5/M6 consumer modules.
#
# R1..R5 are all present in this file.

import("//testing/test.gni")  # provides test() template used below

# ---------------------------------------------------------------------
# R1 — wire-envelope codec.
#
# Pure C++ ↔ JSON codec, no I/O. The only chromium dep is //base for
# base::JSONReader / base::JSONWriter / base::Value. The repo-root
# include path config lives in capture/build-integration/BUILD.gn —
# tests + the embedder pick it up via the existing :cb_include_paths
# config; this BUILD.gn references the codec target by absolute label.
# ---------------------------------------------------------------------
source_set("cb_wire_envelope") {
  sources = [
    "cb_wire_envelope.cc",
    "cb_wire_envelope.h",
  ]
  deps = [
    "//base",
  ]
  configs += [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
  public_configs =
      [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
}

# ---------------------------------------------------------------------
# R1 unit tests — round-trip + negative.
# ---------------------------------------------------------------------
test("cb_wire_envelope_unittests") {
  sources = [ "cb_wire_envelope_test.cc" ]
  deps = [
    ":cb_wire_envelope",
    "//base/test:run_all_unittests",
    "//testing/gmock",
    "//testing/gtest",
  ]
  configs += [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
}

# ---------------------------------------------------------------------
# R2 — native browser-process WebSocket signaling client.
#
# Consumes :cb_wire_envelope for inbound decode + outbound encode.
# Talks to the chromium network service via the
# network::mojom::NetworkContext::CreateWebSocket() Mojo interface;
# the embedder (cloud_browser_browser_main_parts) supplies the
# NetworkContext pointer from the BrowserContext's default
# StoragePartition.
#
# Pure browser-process code — no renderer / no //content/renderer
# deps. The :cb_include_paths config is propagated through the
# :cb_wire_envelope public_configs above.
# ---------------------------------------------------------------------
source_set("cb_signaling_ws_client") {
  sources = [
    "cb_signaling_ws_client.cc",
    "cb_signaling_ws_client.h",
  ]
  deps = [
    ":cb_wire_envelope",
    "//base",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    # //net carries net::IsolationInfo, SiteForCookies, the network
    # traffic annotation taxonomy, GURL/Origin. Pure browser-process
    # dep — no renderer surface.
    "//net",
    # //services/network/public/mojom — the WebSocket + NetworkContext
    # Mojo interface bindings (PendingRemote<WebSocket>,
    # PendingReceiver<WebSocketClient>, WebSocketHandshakeClient,
    # WebSocketMessageType, etc).
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
  configs += [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
  public_configs =
      [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
}

# ---------------------------------------------------------------------
# R2 unit tests — URL builder, env loader, and a FakeNetworkContext
# round-trip that exercises the handshake + read + write pumps with
# a stubbed network service implementation.
#
# TODO(M3-R2-tests): RED-by-construction pre-T17 — adds
# cb_signaling_ws_client_test.cc alongside the R1 tests in a follow-
# up commit. The fixture shape mirrors content_shell's WebSocket
# test pattern (FakeNetworkContext + mojo::Receiver<NetworkContext>
# pair); putting it in once we know the chromium revision's exact
# WebSocket-Mojo arg list keeps the test from drifting twice.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# R3 — ICE-server config source.
#
# Pure config code: reads env vars, parses the streamer.js-shape JSON
# (via //base/json), and returns a value-typed IceConfig holding a
# vector of webrtc::PeerConnectionInterface::IceServer ready to slot
# into RTCConfiguration::servers.
#
# Deps:
#   //base — base::JSONReader / base::Value for the JSON parser.
#   //third_party/webrtc/api — webrtc::PeerConnectionInterface::
#     IceServer + IceTransportsType live in
#     "api/peer_connection_interface.h"; the M1 PCF target already
#     consumes this header via the same passthrough config
#     (capture/build-integration/BUILD.gn :cb_include_paths), so the
#     dep + include path here mirror that pattern.
#
# No mojo, no //net, no chromium UI deps — R3 is pre-PeerConnection
# pure config, deliberately the smallest possible link surface so the
# config parser is testable without the network service.
# ---------------------------------------------------------------------
source_set("cb_ice_config") {
  sources = [
    "cb_ice_config.cc",
    "cb_ice_config.h",
  ]
  deps = [
    "//base",
    # The webrtc passthrough exposes the api/ headers under the
    # //third_party/webrtc/api group; the M1 PCF target depends on
    # the same group for webrtc::PeerConnectionFactoryDependencies
    # (peer_connection_interface.h transitively).
    #
    # TODO(M3-R3-webrtc-dep): on the first compile pass on triform-8,
    # confirm whether the right gn label is
    # "//third_party/webrtc/api:libjingle_peerconnection_api" (the
    # narrow target that owns peer_connection_interface.h) or one of
    # the umbrella groups exposed via patches/0003. The M1 PCF
    # source_set in capture/build-integration/BUILD.gn already pulls
    # in this header through whatever its current dep is — align
    # this dep to that exact label rather than guess here.
  ]
  configs += [
    "//cloud-browser/capture/build-integration:cb_include_paths",
  ]
  public_configs = [
    "//cloud-browser/capture/build-integration:cb_include_paths",
  ]
}

# ---------------------------------------------------------------------
# R3 unit tests — JSON parser + transport-policy mapper + summary
# counter + env-defaulting behaviour.
#
# RED-by-construction pre-T17 — adds cb_ice_config_test.cc in a
# follow-up commit. Test plan (each one falsifiable on a single-
# behaviour change to cb_ice_config.cc):
#
#   * ParseIceServersJson:
#       - empty input → nullopt;
#       - malformed JSON → nullopt;
#       - non-array, non-{iceServers:[]} object → nullopt;
#       - entry without `urls` → dropped, surviving entries kept;
#       - urls string + urls array forms both work;
#       - username/credential populated only when present + non-empty;
#       - all entries dropped → nullopt (so the loader falls back to
#         default STUN, not an empty list).
#   * ParseIceTransportPolicy:
#       - "relay", "RELAY", "Relay" → kRelay;
#       - "all", "", "garbage", "blocked" → kAll.
#   * BuildDefaultIceServers:
#       - returns exactly one server with one url == kDefaultStunUrl.
#   * SummariseIceServers:
#       - mixed stun: / stuns: / turn: / turns: / http: counts split
#         into stun + turn + other respectively.
#   * LoadConfigFromEnv:
#       - WEBRTC_ICE_SERVERS unset → config.servers == default STUN;
#       - WEBRTC_ICE_SERVERS valid → config.servers == parsed list;
#       - WEBRTC_ICE_TRANSPORT_POLICY=relay → config.transport_policy
#         == kRelay; otherwise kAll.
#
# TODO(M3-R3-tests): the LoadConfigFromEnv tests need a deterministic
# env-mutation helper. base::ScopedEnvironmentVariableOverride is the
# right tool here (used elsewhere in chromium browser-process tests);
# wire it in once we know the chromium revision's exact include path.
