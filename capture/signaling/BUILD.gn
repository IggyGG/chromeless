# ---------------------------------------------------------------------
# R4 — offerer handshake driver.
#
# Drives the SDP offer/answer + trickle-ICE dance from the cb-chromium
# side as the sole offerer. Bridges:
#   * M1's PeerConnectionFactory (//cloud-browser/capture/build-
#     integration:cloud_browser_pcf) for CreatePeerConnection.
#   * M3 R1's :cb_wire_envelope for Envelope encode/decode.
#   * M3 R2's :cb_signaling_ws_client for the duplex wire transport.
#   * M3 R3's :cb_ice_config for the RTCConfiguration.servers list
#     fed into CreatePeerConnection.
#
# The webrtc/api deps below pull in the libwebrtc public API surface
# (PeerConnectionInterface, SessionDescriptionInterface,
# IceCandidateInterface, RtcError, scoped_refptr). These ride on the
# chromium-bundled webrtc passthrough config from
# patches/0003-add-cloud-browser-webrtc-overrides.patch — confirm at
# first-build that //third_party/webrtc visibility is propagating
# through :cloud_browser_pcf's public_deps so we don't have to
# re-declare it here.
# ---------------------------------------------------------------------
source_set("cb_offerer_driver") {
  sources = [
    "cb_offerer_driver.cc",
    "cb_offerer_driver.h",
  ]
  deps = [
    ":cb_signaling_ws_client",  # M3 R2
    ":cb_wire_envelope",        # M3 R1
    "//cloud-browser/capture/build-integration:cloud_browser_pcf",  # M1
    "//base",
    # build-czar M-stack fix (2026-05-17): //third_party/webrtc/api:*
    # targets have visibility restricted to //third_party/webrtc/* and
    # //third_party/webrtc_overrides/* — external consumers must go
    # through the cloud-browser passthrough, which re-exports the api/
    # surface (PeerConnectionInterface, SessionDescriptionInterface,
    # IceCandidateInterface, RtcError, scoped_refptr, and the SDP
    # observer interfaces) per patches/0003 + M1-R1 widening. This is
    # the documented pattern used by :cloud_browser_pcf, :input_dispatch,
    # and :stats_relay in capture/build-integration/BUILD.gn.
    "//third_party/webrtc_overrides/cloud_browser:webrtc_api_passthrough",
  ]
  configs += [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
  public_configs =
      [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
}

# ---------------------------------------------------------------------
# R4 unit tests.
#
# cb_offerer_driver_test.cc in a follow-up commit. The fixture shape
# mirrors libwebrtc's pc_test_fixture pattern: a FakePeerConnection
# (or libwebrtc's bundled FakePeerConnection if available) + a
# FakeSignalingWsClient (gmock'd around the SignalingClientObserver
# contract), exercising:
#   * Start() → CreatePeerConnection succeeds → first
#     OnRenegotiationNeeded → CreateOffer → SetLocalDescription →
#     `offer` envelope on the wire (verbatim string match against
#     the M3 R1 round-trip fixture's offer-from-streamer.js corpus).
#   * Inbound `answer` envelope → SetRemoteDescription → state ==
#     kIceInFlight.
#   * OnIceCandidate (3x) → 3 `ice` envelopes on the wire.
#   * OnIceGatheringChange(complete) → `ice` end-of-candidates marker
#     (the MakeIceEndOfCandidates fixture).
#   * Inbound `ice` (3x + end-of-candidates) → AddIceCandidate (3x) +
#     AddIceCandidate(nullptr).
#   * Inbound `offer` → FailWithReason (v1 broker-misroute negative).
#
# R6 (CV2-56) adds the following to the fixture in addition to R4:
#   * Inbound `request_renegotiate` in kIceInFlight → BeginRenegotiation
#     → CreateOffer → SetLocalDescription → SendOfferEnvelope (verbatim
#     against an offer-renegotiated corpus). Observer's
#     OnRenegotiationStarted("remote") fires once.
#   * RequestRenegotiation() from the embedder in kIceInFlight → same
#     dance; observer's OnRenegotiationStarted("embedder") fires once.
#   * Second OnRenegotiationNeeded() from libwebrtc post-initial →
#     same dance; observer's OnRenegotiationStarted("libwebrtc") fires
#     once.
#   * Coalescing: 3 rapid RequestRenegotiation() calls mid-dance → exactly
#     one BeginRenegotiation("coalesced-pending") fires on the next
#     kIceInFlight transition.
#   * Inbound `bye` → CloseInternal → observer's OnClosed("remote bye")
#     fires once; pc dropped; state = kClosed. Second `bye` is a no-op.
#   * Close("session ended") in kIceInFlight → SendByeEnvelope → observer's
#     OnClosed("session ended") fires once. Second Close() is a no-op.
#   * Close() during kCreatingOffer → bye emit suppressed (state guard);
#     observer's OnClosed fires; pc dropped. No CreateOffer success/fail
#     handlers fire after teardown (weak_factory_'s WeakPtr invalidates
#     them).
#
# Putting the tests in once we know the chromium revision's libwebrtc
# FakePeerConnection availability keeps the test from drifting twice.
# If libwebrtc's bundled FakePeerConnection is unavailable in the
# chromium-bundled tree, a hand-rolled gmock<PeerConnectionInterface>
# is fine — every method the driver calls is on the public interface.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# R5 — DataChannel host.
#
# Owns the post-handshake DCs created on M3 R4's PeerConnection.
# Single source_set with no test() target in R1 — the unit-test
# scaffolding for the host lands once M1 first-green proves the
# fixtures actually compile against the chromium-pinned libwebrtc.
# TODO(M3-R5-tests): cb_dc_host_test.cc + test() target — covers
# the observer-trampoline forwarding, latched all-open semantics,
# Send()-while-not-open kInvalidState, Shutdown-before-PC-drop
# ordering, and the create_called_ idempotence guard.
# ---------------------------------------------------------------------
source_set("cb_dc_host") {
  sources = [
    "cb_dc_host.cc",
    "cb_dc_host.h",
  ]
  deps = [
    "//base",
    # libwebrtc — DataChannelInterface, PeerConnectionInterface,
    # rtc::CopyOnWriteBuffer. build-czar M-stack fix (2026-05-17):
    # //third_party/webrtc/api:* has visibility restricted to webrtc/*
    # and webrtc_overrides/* — go through the cloud-browser passthrough
    # which re-exports the api/ surface (DataChannelInterface,
    # PeerConnectionInterface, scoped_refptr) per patches/0003 + M1-R1
    # widening. copy_on_write_buffer lives outside api/ and keeps its
    # own (likely-open) visibility; tentatively retained — if its own
    # visibility check fires next, fold it under the passthrough too.
    "//third_party/webrtc_overrides/cloud_browser:webrtc_api_passthrough",
    "//third_party/webrtc/rtc_base:copy_on_write_buffer",
  ]
  # Repo-root include-path config — propagated transitively so the
  # `#include "capture/signaling/cb_dc_host.h"` form resolves the same
  # way M1's headers resolve. Same config M3 R1..R4 use.
  configs += [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
  public_configs =
      [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
}

# ---------------------------------------------------------------------
# R7 — reconnect supervisor + idle-timeout keepalive substitute.
#
# Pure browser-process code. Depends on :cb_signaling_ws_client (R2)
# for the inner client and :cb_wire_envelope (R1) for the Envelope
# struct passed through the observer API. Adds //base/timer for
# base::OneShotTimer and //base for base::TimeDelta. No new chromium
# subsystem deps beyond what R2 already pulls in.
# ---------------------------------------------------------------------
source_set("cb_signaling_reconnect") {
  sources = [
    "cb_signaling_reconnect.cc",
    "cb_signaling_reconnect.h",
  ]
  deps = [
    ":cb_signaling_ws_client",
    ":cb_wire_envelope",
    "//base",
    # //services/network/public/mojom for the NetworkContext* the
    # wrapper threads through to the inner client on each
    # reconnect attempt.
    "//services/network/public/mojom",
  ]
  configs += [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
  public_configs =
      [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
}

# ---------------------------------------------------------------------
# R7 unit tests — backoff schedule, idle-timeout firing, give-up
# behaviour, observer translation.
#
# TODO(M3-R7-tests): RED-by-construction pre-T17 — adds
# cb_signaling_reconnect_test.cc in a follow-up commit. The fixture
# will use a FakeSignalingWsClient (a SignalingClientObserver-callback-
# driven double, not the real R2 client) so the tests don't need a
# FakeNetworkContext. Drives the wrapper through:
#
#   * happy path: Connect → OnConnected → OnEnvelope → Disconnect →
#     OnClosed(1000).
#   * remote close → reconnect: OnConnected → OnClosed(1006) → wait
#     initial_backoff → fresh inner constructed → OnConnected resets
#     attempts_made_ to 0.
#   * exponential backoff: 4 reconnect attempts, assert delays follow
#     initial × multiplier^N up to max_backoff cap.
#   * give-up: max_attempts=2 + persistent OnError → OnGaveUp(2) fires.
#   * idle timeout: OnConnected → no envelopes for idle_timeout →
#     OnIdleFired schedules a reconnect (counts toward max_attempts).
#   * idle timeout disabled: idle_timeout=0 → timer never armed.
#   * consumer Disconnect during backoff: backoff timer cancelled,
#     no further reconnect fires, OnClosed(1000) delivered to
#     consumer.
#
# The test uses base::test::TaskEnvironment::TimeSource::MOCK_TIME so
# the FastForwardBy() helper can advance through the backoff schedule
# deterministically without real sleeps.
# ---------------------------------------------------------------------
