# ---------------------------------------------------------------------
# R3 — ICE-server config source.
#
# Pure config code: reads env vars, parses the streamer.js-shape JSON
# (via //base/json), and returns a value-typed IceConfig holding a
# vector of webrtc::PeerConnectionInterface::IceServer ready to slot
# into RTCConfiguration::servers.
#
# Deps:
#   //base — base::JSONReader / base::Value for the JSON parser.
#   //third_party/webrtc/api — webrtc::PeerConnectionInterface::
#     IceServer + IceTransportsType live in
#     "api/peer_connection_interface.h"; the M1 PCF target already
#     consumes this header via the same passthrough config
#     (capture/build-integration/BUILD.gn :cb_include_paths), so the
#     dep + include path here mirror that pattern.
#
# No mojo, no //net, no chromium UI deps — R3 is pre-PeerConnection
# pure config, deliberately the smallest possible link surface so the
# config parser is testable without the network service.
# ---------------------------------------------------------------------
source_set("cb_ice_config") {
  sources = [
    "cb_ice_config.cc",
    "cb_ice_config.h",
  ]
  deps = [
    "//base",
    # The webrtc passthrough exposes the api/ headers under the
    # //third_party/webrtc/api group; the M1 PCF target depends on
    # the same group for webrtc::PeerConnectionFactoryDependencies
    # (peer_connection_interface.h transitively).
    #
    # TODO(M3-R3-webrtc-dep): on the first compile pass on triform-8,
    # confirm whether the right gn label is
    # "//third_party/webrtc/api:libjingle_peerconnection_api" (the
    # narrow target that owns peer_connection_interface.h) or one of
    # the umbrella groups exposed via patches/0003. The M1 PCF
    # source_set in capture/build-integration/BUILD.gn already pulls
    # in this header through whatever its current dep is — align
    # this dep to that exact label rather than guess here.
  ]
  configs += [
    "//cloud-browser/capture/build-integration:cb_include_paths",
  ]
  public_configs = [
    "//cloud-browser/capture/build-integration:cb_include_paths",
  ]
}

