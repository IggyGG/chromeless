#
# gn targets for the cb-chromium ↔ physics signaling client.
#
# # Module decomposition (CV2-50 .. CV2-54, M3)
#
#   R1 (:cb_wire_envelope) — pure codec: typed envelope struct + JSON
#       encode/decode for the six source-pinned tags. No I/O, no
#       threading. Linkable on its own so tests don't drag in the
#       chromium net stack.
#   R2 (:cb_signaling_ws_client) — native WebSocket client (rides on
#       //services/network's NetworkContext::CreateWebSocket Mojo
#       interface). This file.
#   R3  — ICE config endpoint fetch + TURN credential rotation.
#   R4  — PeerConnection wire-up on M1's PCF.
#   R5  — DataChannel host (input, cursor, ancillary).
#
# R1 and R2 are both present in this file; R3..R5 add more source_sets
# as they land.
#
# Pre-merge note (M3 R2 draft) — this BUILD.gn was authored alongside
# the cv2/m3-signaling-ws-client branch and assumes the cv2/m3-wire-
# envelope-codec branch (R1, commit f51d5c4) has merged first; the
# :cb_wire_envelope target below is duplicated verbatim from R1 to
# keep R2 self-contained until the merge resolves the duplicate.

import("//testing/test.gni")  # provides test() template used below

# ---------------------------------------------------------------------
# R1 — wire-envelope codec.
#
# Pure C++ ↔ JSON codec, no I/O. The only chromium dep is //base for
# base::JSONReader / base::JSONWriter / base::Value. The repo-root
# include path config lives in capture/build-integration/BUILD.gn —
# tests + the embedder pick it up via the existing :cb_include_paths
# config; this BUILD.gn references the codec target by absolute label.
# ---------------------------------------------------------------------
source_set("cb_wire_envelope") {
  sources = [
    "cb_wire_envelope.cc",
    "cb_wire_envelope.h",
  ]
  deps = [
    "//base",
  ]
  configs += [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
  public_configs =
      [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
}

# ---------------------------------------------------------------------
# R1 unit tests — round-trip + negative.
# ---------------------------------------------------------------------
test("cb_wire_envelope_unittests") {
  sources = [ "cb_wire_envelope_test.cc" ]
  deps = [
    ":cb_wire_envelope",
    "//base/test:run_all_unittests",
    "//testing/gmock",
    "//testing/gtest",
  ]
  configs += [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
}

# ---------------------------------------------------------------------
# R2 — native browser-process WebSocket signaling client.
#
# Consumes :cb_wire_envelope for inbound decode + outbound encode.
# Talks to the chromium network service via the
# network::mojom::NetworkContext::CreateWebSocket() Mojo interface;
# the embedder (cloud_browser_browser_main_parts) supplies the
# NetworkContext pointer from the BrowserContext's default
# StoragePartition.
#
# Pure browser-process code — no renderer / no //content/renderer
# deps. The :cb_include_paths config is propagated through the
# :cb_wire_envelope public_configs above.
# ---------------------------------------------------------------------
source_set("cb_signaling_ws_client") {
  sources = [
    "cb_signaling_ws_client.cc",
    "cb_signaling_ws_client.h",
  ]
  deps = [
    ":cb_wire_envelope",
    "//base",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    # //net carries net::IsolationInfo, SiteForCookies, the network
    # traffic annotation taxonomy, GURL/Origin. Pure browser-process
    # dep — no renderer surface.
    "//net",
    # //services/network/public/mojom — the WebSocket + NetworkContext
    # Mojo interface bindings (PendingRemote<WebSocket>,
    # PendingReceiver<WebSocketClient>, WebSocketHandshakeClient,
    # WebSocketMessageType, etc).
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
  configs += [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
  public_configs =
      [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
}

# ---------------------------------------------------------------------
# R2 unit tests — URL builder, env loader, and a FakeNetworkContext
# round-trip that exercises the handshake + read + write pumps with
# a stubbed network service implementation.
#
