#
# gn targets for the cb-chromium native cursor egress pipeline —
# M5 R5 (custom CSS cursor image extraction) addendum.
#
# NOTE (merge): this file is named BUILD.gn.r5 so it does NOT collide
# at apply-time with M5 R2's draft capture/cursor/BUILD.gn (799e48a)
# or M5 R4's draft (6dea7f3). The merger of integration/native-peer
# concatenates these source_set blocks into a single
# capture/cursor/BUILD.gn — same convention M5 R4's commit message
# spells out ("separate from M5 R2's draft capture/cursor/BUILD.gn;
# merge concatenates"). Whoever lands the merge:
#
#   1. Open R2's BUILD.gn at apply-time.
#   2. Append the source_set("cb_custom_cursor_image") block below
#      verbatim.
#   3. Delete this .r5 file.
#
# # Module decomposition recap (CV2-19 .. CV2-24, M5)
#
#   R1 — capture/build-integration/cb_cursor_client.{h,cc}
#   R2 — capture/cursor/cb_cursor_envelope.{h,cc} (THIS DIR)
#   R3 — DataChannel emission (M3 R5 binding)
#   R4 — capture/cursor/cb_cursor_emit_policy.{h,cc} (THIS DIR)
#   R5 — capture/cursor/cb_custom_cursor_image.{h,cc} (THIS DIR)
#        Pure extractor: ui::Cursor.custom_bitmap() → PNG → base64,
#        with 64 KiB encoded cap + envelope-apply helper.
#   R6 — physical removal of capture/cursor-watcher/ + JS probe.

import("//testing/test.gni")

# ---------------------------------------------------------------------
# R5 — custom CSS cursor image extractor.
#
# Pure C++ helper: reads a ui::Cursor, encodes its SkBitmap as PNG,
# base64s the bytes, enforces the cursor-channel v1 64 KiB encoded
# cap, and applies the result onto a R2 V1EnvelopeView.
#
# Dep cone:
#   //base                              — base::Base64Encode, LOG
#   //skia                              — SkBitmap
#   //ui/base/cursor                    — ui::Cursor + custom_bitmap
#   //ui/base/cursor/mojom:cursor_type_shared — kCustom enumerator
#   //ui/gfx/codec                      — gfx::PNGCodec
#   //ui/gfx/geometry                   — gfx::Point (hotspot)
#   :cb_cursor_envelope                 — V1EnvelopeView fwd → struct
#
# The :cb_cursor_envelope public dep keeps the apply-to-envelope
# helper linkable without forcing every translation unit that calls
# ExtractCustomImage to drag in cb_cursor_envelope.h itself —
# call sites that only want the extraction (the M5 acceptance
# probe's pod-log scraper, for example) skip the envelope include.
# ---------------------------------------------------------------------
source_set("cb_custom_cursor_image") {
  sources = [
    "cb_custom_cursor_image.cc",
    "cb_custom_cursor_image.h",
  ]
  deps = [
    "//base",
    "//skia",
    "//ui/base/cursor",
    "//ui/base/cursor/mojom:cursor_type_shared",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
  ]
  public_deps = [
    ":cb_cursor_envelope",
  ]
  configs += [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
  public_configs =
      [ "//cloud-browser/capture/build-integration:cb_include_paths" ]
}

# TODO(M5-R5-tests): cb_custom_cursor_image_test.cc covering:
#   * non-kCustom cursor → ok=false, skip=kNotCustom
#   * kCustom with isNull() bitmap → ok=false, skip=kBitmapEmpty
#   * 0x0 bitmap → ok=false, skip=kBitmapEmpty
#   * 8x8 transparent PNG round-trip → ok=true, decode equals input
#   * 8 8 hotspot from cursor:url(...) 8 8,auto → hotspot_x/y == 8
#   * synthetic 256x256 fully-opaque random bitmap → kOverCap drop
#     (verify b64 length actually exceeds 65536 with the chosen size
#     to make the test self-falsifying, not vacuously-passing)
#   * ApplyExtractionToEnvelope writes when ok=true, no-op when ok=false
# Test target is omitted from this draft because it would need the
# //skia + //ui/gfx/codec test-support pulled in; the M5 R6 acceptance
# script covers the end-to-end signal directly.
