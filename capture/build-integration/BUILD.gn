#
# gn target for the Phase-2 cloud-browser worker binary.
#
# This binary embeds Chromium (browser process), instantiates
# HostFrameSinkManager + a FrameSinkVideoCapturer (T47), routes the
# captured frames into libwebrtc with our CloudBrowserVideoEncoderFactory
# (T19 / T35 / T36) plugged in, and runs the WebRTC sender side of the
# pipeline.
#
# Layout assumes this repo is symlinked into the Chromium src/ tree at
# //cloud-browser. The encoder sources still live at //cloud-browser/
# capture/encoder/...; this BUILD.gn references them via that path.
#
# TODO(T17-build-env): exercise this on a Linux box with depot_tools.

import("//build/config/features.gni")
import("//build/config/sanitizers/sanitizers.gni")
import("//testing/test.gni")  # provides test() template used below

# ---------------------------------------------------------------------
# Encoder factory + per-codec wrappers.
#
# Linkable on its own so unit tests in capture/encoder/*_test.cc can
# pick it up without dragging in the worker binary's main().
# ---------------------------------------------------------------------
# NVENC SDK gate. The NVIDIA Video Codec SDK is not redistributable
# under our license, so it must be installed out-of-band and pointed
# at via `nvenc_sdk_path` in args.gn (default empty disables HW). When
# enabled, this config:
#   * adds <nvEncodeAPI.h> + <cuda.h> to the include path
#   * defines HAS_NVENC so nvenc_encoder.cc compiles its real path
#   * links libnvidia-encode.so + libcuda.so
declare_args() {
  # Path to a checked-out NVIDIA Video Codec SDK. Empty = HW disabled,
  # encoder still compiles and runs as software-only via the factory's
  # runtime probe.
  nvenc_sdk_path = ""

  # Path to a libva install (typically /usr — empty disables VAAPI HW
  # encode entirely). Same shape as nvenc_sdk_path: empty = HW
  # disabled, encoder still compiles and runs as software-only.
  vaapi_libdir = ""

  # Path to a libSvtAv1Enc install (typically /usr or a checked-out
  # SVT-AV1 build dir). Empty = SW AV1 disabled — the encoder still
  # compiles, but ProbeAvailable() returns false and the factory
  # falls through to whatever lower-priority codec libwebrtc
  # negotiates. T75.
  svt_av1_libdir = ""

  # Path to a libx264 install (typically /usr for the Debian
  # libx264-dev package). libx264 is GPL-licensed and not redistributable
  # inside chromium, so we link it dynamically when present and
  # leave it off by default. Empty = SW H.264 disabled — h264_encoder.cc
  # still compiles, but ProbeAvailable() returns false and the factory
  # falls through to lower-priority codecs. Same shape as vaapi_libdir.
  # T36.
  x264_libdir = ""
}

config("nvenc_sdk") {
  if (nvenc_sdk_path != "") {
    defines = [ "HAS_NVENC=1" ]
    include_dirs = [
      "$nvenc_sdk_path/Interface",
      # System CUDA headers are picked up from /usr/local/cuda/include.
      "/usr/local/cuda/include",
    ]
    libs = [
      "nvidia-encode",
      "cuda",
    ]
    lib_dirs = [ "/usr/local/cuda/lib64" ]
  }
}

# VAAPI gate (T70). libva is an Apache-2.0-licensed library typically
# installed system-wide via the libva-dev / libva-drm-dev Debian/
# Ubuntu packages; we link it dynamically. When `vaapi_libdir` is set
# we add the include + lib paths and define HAS_VAAPI; otherwise the
# encoder falls back to software via runtime probe.
config("vaapi") {
  if (vaapi_libdir != "") {
    defines = [ "HAS_VAAPI=1" ]
    include_dirs = [ "$vaapi_libdir/include" ]
    libs = [
      "va",
      "va-drm",
    ]
    lib_dirs = [ "$vaapi_libdir/lib" ]
  }
}

# SVT-AV1 gate (T75). libSvtAv1Enc is BSD-3-Clause and packaged on
# Debian as `libsvtav1enc-dev`; we link it dynamically. Empty
# `svt_av1_libdir` = HAS_SVT_AV1 undefined → ProbeAvailable returns
# false → factory falls through.
config("svt_av1") {
  if (svt_av1_libdir != "") {
    defines = [ "HAS_SVT_AV1=1" ]
    include_dirs = [ "$svt_av1_libdir/include/svt-av1" ]
    libs = [ "SvtAv1Enc" ]
    lib_dirs = [ "$svt_av1_libdir/lib" ]
  }
}

# x264 gate (T36). libx264 is GPL-licensed and not redistributable inside
# chromium, so we cannot use //third_party/x264 (it does not exist in the
# upstream tree). Instead we link the system libx264 dynamically when
# present. Empty `x264_libdir` = HAS_X264 undefined → ProbeAvailable
# returns false → factory falls through.
config("x264") {
  if (x264_libdir != "") {
    defines = [ "HAS_X264=1" ]
    include_dirs = [ "$x264_libdir/include" ]
    libs = [ "x264" ]
    lib_dirs = [ "$x264_libdir/lib" ]
  }
}

source_set("encoder_factory") {
  sources = [
    "../encoder/bwe_adapter.cc",
    "../encoder/bwe_adapter.h",
    "../encoder/encoder_factory.h",
    "../encoder/encoder_factory_stub.cc",
    "../encoder/h264_encoder.cc",
    "../encoder/h264_encoder.h",
    "../encoder/nvenc_encoder.cc",
    "../encoder/nvenc_encoder.h",
    "../encoder/simulcast_factory.cc",
    "../encoder/simulcast_factory.h",
    "../encoder/svtav1_encoder.cc",
    "../encoder/svtav1_encoder.h",
    "../encoder/vaapi_encoder.cc",
    "../encoder/vaapi_encoder.h",
    "../encoder/vp9_encoder.cc",
    "../encoder/vp9_encoder.h",
  ]
  deps = [
    "//third_party/abseil-cpp:absl",
    "//third_party/libvpx:libvpx",     # VP9 (T35).
    "//third_party/libyuv:libyuv",     # I420Scale (T83).
    # All webrtc public-API deps go through the passthrough source_set in
    # //third_party/webrtc_overrides/cloud_browser/ — chromium's
    # rtc_library template restricts visibility on every webrtc internal
    # target to [ //third_party/webrtc/*, //third_party/webrtc_overrides/* ],
    # and the passthrough lives in the second of those, re-exporting via
    # public_deps. Add new webrtc deps there, not here. Authored by
    # patches/0003-add-cloud-browser-webrtc-overrides.patch.
    "//third_party/webrtc_overrides/cloud_browser:webrtc_api_passthrough",
    # T36 (libx264) is now linked via config(":x264") + system libx264 —
    # chromium does not ship //third_party/x264:x264 (GPL).
    # TODO(T43): //third_party/svt_av1 once AV1 lands.
  ]
  configs += [
    ":nvenc_sdk",                                # T63 — gated on
                                                  # nvenc_sdk_path != "".
    ":vaapi",                                    # T70 — gated on
                                                  # vaapi_libdir != "".
    ":svt_av1",                                  # T75 — gated on
                                                  # svt_av1_libdir != "".
    ":x264",                                     # T36 — gated on
                                                  # x264_libdir != "".
    "//build/config/compiler:no_chromium_code",
  ]
}

# ---------------------------------------------------------------------
# Capture seam — CloudBrowserFrameSinkCapturer (T55).
#
# Consumer end of Viz's FrameSinkVideoCapturer Mojo. Hands captured
# frames to the encoder factory pipeline; see
# capture/framesink-capturer/README.md for the wire-up.
# ---------------------------------------------------------------------
source_set("framesink_capture") {
  sources = [
    "../framesink-capturer/capturer.cc",
    "../framesink-capturer/capturer.h",
  ]
  deps = [
    "//base",
    "//components/viz/common",
    "//components/viz/host",
    "//components/viz/service",
    "//media",
    "//media/mojo/common",
    "//media/mojo/mojom",
    "//mojo/public/cpp/bindings",
    "//services/viz/privileged/mojom",
    "//third_party/abseil-cpp:absl",
    "//ui/gfx/geometry",
  ]
}

# ---------------------------------------------------------------------
# Embedder glue — our ContentBrowserClient subclass that overrides
# the virtual added by patches/0001-expose-encoder-factory-injection.
# patch.
# ---------------------------------------------------------------------
source_set("embedder") {
  sources = [
    "cloud_browser_main.cc",
    "cloud_browser_main.h",
    "content_browser_client.cc",
    "content_browser_client.h",
  ]
  deps = [
    ":encoder_factory",
    ":framesink_capture",
    "//base",
    "//content/public/app",
    "//content/public/browser",
  ]
}

# ---------------------------------------------------------------------
# The binary itself.
# ---------------------------------------------------------------------
executable("cloud_browser_worker") {
  sources = [ "cloud_browser_worker_main.cc" ]
  deps = [
    ":embedder",
  ]
  # cloud_browser_worker is a Linux-server binary; we don't carry mac/
  # win configs.
  if (!is_linux) {
    assert(false, "cloud_browser_worker is Linux-only (Phase 2 scope)")
  }
}

# ---------------------------------------------------------------------
# Unit tests for the encoder factory wrappers.
#
# These are gtest-based and link against //third_party/webrtc/test —
# T17's pinned branch's libwebrtc test deps. Until the build env runs,
# this is design-by-spec (matches the TODO marker in each *_test.cc).
# ---------------------------------------------------------------------
test("cloud_browser_encoder_unittests") {
  sources = [
    "../encoder/bwe_adapter_test.cc",
    "../encoder/h264_encoder_test.cc",
    "../encoder/nvenc_encoder_test.cc",
    "../encoder/simulcast_factory_test.cc",
    "../encoder/svtav1_encoder_test.cc",
    "../encoder/vaapi_encoder_test.cc",
    "../encoder/vp9_encoder_test.cc",
  ]
  deps = [
    ":encoder_factory",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/webrtc_overrides/cloud_browser:webrtc_api_passthrough",
    "//third_party/webrtc_overrides/cloud_browser:webrtc_test_passthrough",
  ]
  configs += [
    ":nvenc_sdk",
    ":svt_av1",
    ":vaapi",
    ":x264",
  ]
}

# ---------------------------------------------------------------------
# Unit tests for the FrameSink capturer (T55).
# ---------------------------------------------------------------------
test("cloud_browser_framesink_capturer_unittests") {
  sources = [ "../framesink-capturer/capturer_test.cc" ]
  deps = [
    ":framesink_capture",
    "//base/test:test_support",
    "//media/mojo/mojom",
    "//mojo/public/cpp/bindings",
    "//services/viz/privileged/mojom",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx/geometry",
  ]
}
