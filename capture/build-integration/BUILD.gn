#
# gn target for the Phase-2 cloud-browser worker binary.
#
# This binary embeds Chromium (browser process), instantiates
# HostFrameSinkManager + a FrameSinkVideoCapturer (T47), routes the
# captured frames into libwebrtc with our CloudBrowserVideoEncoderFactory
# (T19 / T35 / T36) plugged in, and runs the WebRTC sender side of the
# pipeline.
#
# Layout assumes this repo is symlinked into the Chromium src/ tree at
# //cloud-browser. The encoder sources still live at //cloud-browser/
# capture/encoder/...; this BUILD.gn references them via that path.
#
# TODO(T17-build-env): exercise this on a Linux box with depot_tools.

import("//build/config/features.gni")
import("//build/config/sanitizers/sanitizers.gni")
import("//testing/test.gni")  # provides test() template used below

# ---------------------------------------------------------------------
# Encoder factory + per-codec wrappers.
#
# Linkable on its own so unit tests in capture/encoder/*_test.cc can
# pick it up without dragging in the worker binary's main().
# ---------------------------------------------------------------------
# NVENC SDK gate. The NVIDIA Video Codec SDK is not redistributable
# under our license, so it must be installed out-of-band and pointed
# at via `nvenc_sdk_path` in args.gn (default empty disables HW). When
# enabled, this config:
#   * adds <nvEncodeAPI.h> + <cuda.h> to the include path
#   * defines HAS_NVENC so nvenc_encoder.cc compiles its real path
#   * links libnvidia-encode.so + libcuda.so
declare_args() {
  # Path to a checked-out NVIDIA Video Codec SDK. Empty = HW disabled,
  # encoder still compiles and runs as software-only via the factory's
  # runtime probe.
  nvenc_sdk_path = ""

  # Path to a libva install (typically /usr — empty disables VAAPI HW
  # encode entirely). Same shape as nvenc_sdk_path: empty = HW
  # disabled, encoder still compiles and runs as software-only.
  vaapi_libdir = ""

  # Path to a libSvtAv1Enc install (typically /usr or a checked-out
  # SVT-AV1 build dir). Empty = SW AV1 disabled — the encoder still
  # compiles, but ProbeAvailable() returns false and the factory
  # falls through to whatever lower-priority codec libwebrtc
  # negotiates. T75.
  svt_av1_libdir = ""

  # Path to a libx264 install (typically /usr for the Debian
  # libx264-dev package). libx264 is GPL-licensed and not redistributable
  # inside chromium, so we link it dynamically when present and
  # leave it off by default. Empty = SW H.264 disabled — h264_encoder.cc
  # still compiles, but ProbeAvailable() returns false and the factory
  # falls through to lower-priority codecs. Same shape as vaapi_libdir.
  # T36.
  x264_libdir = ""
}

config("nvenc_sdk") {
  if (nvenc_sdk_path != "") {
    defines = [ "HAS_NVENC=1" ]
    include_dirs = [
      "$nvenc_sdk_path/Interface",
      # System CUDA headers are picked up from /usr/local/cuda/include.
      "/usr/local/cuda/include",
    ]
    libs = [
      "nvidia-encode",
      "cuda",
    ]
    lib_dirs = [ "/usr/local/cuda/lib64" ]
  }
}

# VAAPI gate (T70). libva is an Apache-2.0-licensed library packaged
# on Debian as `libva-dev` (single dev package; no libva-drm-dev on
# Debian — that name is Ubuntu-only); we link it dynamically. When
# `vaapi_libdir` is set we add the include + lib paths and define
# HAS_VAAPI; otherwise the encoder falls back to software via runtime
# probe.
#
# --allow-shlib-undefined: same bookworm/bullseye glibc skew the
# `:x264` config below already documents. The libva we stage from the
# build host is built against bookworm (glibc 2.36); chromium pins
# its sysroot to bullseye (glibc 2.31) for ABI stability. At link
# time, lld sees libva.so referencing dlopen@GLIBC_2.34,
# dlerror@GLIBC_2.34, dlsym@GLIBC_2.34, dlclose@GLIBC_2.34 (libdl was
# merged into libc.so.6 in glibc 2.34) and rejects the link with
# --no-allow-shlib-undefined (lld's default). Allowing it lets the
# binary link; at runtime the cb-chromium image (debian bookworm,
# glibc 2.36) supplies the symbols.
config("vaapi") {
  if (vaapi_libdir != "") {
    defines = [ "HAS_VAAPI=1" ]
    include_dirs = [ "$vaapi_libdir/include" ]
    libs = [
      "va",
      "va-drm",
    ]
    lib_dirs = [ "$vaapi_libdir/lib" ]
    ldflags = [ "-Wl,--allow-shlib-undefined" ]
  }
}

# SVT-AV1 gate (T75). libSvtAv1Enc is BSD-3-Clause and packaged on
# Debian as `libsvtav1enc-dev`; we link it dynamically. Empty
# `svt_av1_libdir` = HAS_SVT_AV1 undefined → ProbeAvailable returns
# false → factory falls through.
config("svt_av1") {
  if (svt_av1_libdir != "") {
    defines = [ "HAS_SVT_AV1=1" ]
    include_dirs = [ "$svt_av1_libdir/include/svt-av1" ]
    libs = [ "SvtAv1Enc" ]
    lib_dirs = [ "$svt_av1_libdir/lib" ]
  }
}

# Project-relative include root (T17). The cloud-browser repo is symlinked
# into chromium's src/ tree at //cloud-browser, but our source files use
# "capture/..." / "framesink-capturer/..." include paths assuming the
# repo root itself is on the include path. Targets that compile our
# sources OR depend on those targets pick this up via public_configs so
# the include path propagates transitively.
config("cb_include_paths") {
  include_dirs = [ "//cloud-browser" ]
}

# x264 gate (T36). libx264 is GPL-licensed and not redistributable inside
# chromium, so we cannot use //third_party/x264 (it does not exist in the
# upstream tree). Instead we link the system libx264 dynamically when
# present. Empty `x264_libdir` = HAS_X264 undefined → ProbeAvailable
# returns false → factory falls through.
#
# --allow-shlib-undefined: chromium pins its sysroot to debian bullseye
# (glibc 2.31) for ABI stability, but the libx264 we stage from the
# build host is built against bookworm (glibc 2.36). At link time, lld
# sees libx264 references pthread_join@GLIBC_2.34, dlopen@GLIBC_2.34,
# fstat64@GLIBC_2.33, etc. (these were merged from libpthread/libdl
# into libc.so.6 in glibc 2.34) and rejects the link with
# --no-allow-shlib-undefined (lld's default). Allowing it lets the
# binary link; at runtime the cb-chromium image (debian bookworm,
# glibc 2.36) supplies the symbols.
config("x264") {
  if (x264_libdir != "") {
    defines = [ "HAS_X264=1" ]
    include_dirs = [ "$x264_libdir/include" ]
    libs = [ "x264" ]
    lib_dirs = [ "$x264_libdir/lib" ]
    ldflags = [ "-Wl,--allow-shlib-undefined" ]
  }
}

source_set("encoder_factory") {
  sources = [
    "../encoder/bwe_adapter.cc",
    "../encoder/bwe_adapter.h",
    "../encoder/encoder_factory.h",
    "../encoder/encoder_factory_stub.cc",
    "../encoder/h264_encoder.cc",
    "../encoder/h264_encoder.h",
    "../encoder/nvenc_encoder.cc",
    "../encoder/nvenc_encoder.h",
    "../encoder/simulcast_factory.cc",
    "../encoder/simulcast_factory.h",
    "../encoder/svtav1_encoder.cc",
    "../encoder/svtav1_encoder.h",
    "../encoder/vaapi_encoder.cc",
    "../encoder/vaapi_encoder.h",
    "../encoder/vp9_encoder.cc",
    "../encoder/vp9_encoder.h",
  ]
  deps = [
    "//third_party/abseil-cpp:absl",
    "//third_party/libvpx:libvpx",     # VP9 (T35).
    "//third_party/libyuv:libyuv",     # I420Scale (T83).
    # All webrtc public-API deps go through the passthrough source_set in
    # //third_party/webrtc_overrides/cloud_browser/ — chromium's
    # rtc_library template restricts visibility on every webrtc internal
    # target to [ //third_party/webrtc/*, //third_party/webrtc_overrides/* ],
    # and the passthrough lives in the second of those, re-exporting via
    # public_deps. Add new webrtc deps there, not here. Authored by
    # patches/0003-add-cloud-browser-webrtc-overrides.patch.
    "//third_party/webrtc_overrides/cloud_browser:webrtc_api_passthrough",
    # T36 (libx264) is now linked via config(":x264") + system libx264 —
    # chromium does not ship //third_party/x264:x264 (GPL).
    # TODO(T43): //third_party/svt_av1 once AV1 lands.
  ]
  configs += [
    ":cb_include_paths",                         # T17 — repo-root
                                                  # include path.
    ":nvenc_sdk",                                # T63 — gated on
                                                  # nvenc_sdk_path != "".
    ":vaapi",                                    # T70 — gated on
                                                  # vaapi_libdir != "".
    ":svt_av1",                                  # T75 — gated on
                                                  # svt_av1_libdir != "".
    ":x264",                                     # T36 — gated on
                                                  # x264_libdir != "".
    "//build/config/compiler:no_chromium_code",
  ]
  # Propagate the repo-root include path to anything that depends on us
  # (test target, embedder source_set, cloud_browser_worker executable),
  # so they don't each have to repeat include_dirs.
  public_configs = [ ":cb_include_paths" ]
}

# ---------------------------------------------------------------------
# Capture seam — CloudBrowserFrameSinkCapturer (T55).
#
# Consumer end of Viz's FrameSinkVideoCapturer Mojo. Hands captured
# frames to the encoder factory pipeline; see
# capture/framesink-capturer/README.md for the wire-up.
# ---------------------------------------------------------------------
source_set("framesink_capture") {
  sources = [
    "../framesink-capturer/capturer.cc",
    "../framesink-capturer/capturer.h",
  ]
  deps = [
    "//base",
    "//components/viz/common",
    "//components/viz/host",
    "//components/viz/service",
    "//media",
    "//media/mojo/common",
    "//media/mojo/mojom",
    "//mojo/public/cpp/bindings",
    "//services/viz/privileged/mojom",
    "//third_party/abseil-cpp:absl",
    "//ui/gfx/geometry",
  ]
  configs += [ ":cb_include_paths" ]              # T17.
  public_configs = [ ":cb_include_paths" ]
}

# ---------------------------------------------------------------------
# Embedder glue — our ContentBrowserClient subclass that overrides
# the virtual added by patches/0001-expose-encoder-factory-injection.
# patch.
# ---------------------------------------------------------------------
source_set("embedder") {
  sources = [
    "cb_devtools_agent.cc",
    "cb_devtools_agent.h",
    "cloud_browser_browser_context.cc",
    "cloud_browser_browser_context.h",
    "cloud_browser_browser_main_parts.cc",
    "cloud_browser_browser_main_parts.h",
    "cloud_browser_main.cc",
    "cloud_browser_main.h",
    "content_browser_client.cc",
    "content_browser_client.h",
  ]
  deps = [
    ":encoder_factory",
    ":framesink_capture",
    "//base",
    # cloud_browser_browser_context.cc registers with the
    # BrowserContext / Simple keyed-service dependency managers (same
    # shape every chromium embedder uses; see
    # content/shell/browser/shell_browser_context.cc and
    # headless/lib/browser/headless_browser_context_impl.cc for the
    # canonical templates).
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    # cb_devtools_agent.cc uses inspector_protocol's CBOR + dispatch
    # primitives to parse the incoming Cb.* command and emit the
    # response. crdtp is the same library every upstream embedder
    # delegate (content_shell + headless) uses for the same job.
    "//components/viz/common",
    "//components/viz/host",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//media",
    "//mojo/public/cpp/bindings",
    # cloud_browser_browser_main_parts.cc opens a TCPServerSocket on
    # the loopback for the DevTools HTTP listener — same shape every
    # other chromium embedder uses (content_shell, headless).
    "//net",
    "//services/viz/privileged/mojom",
    "//third_party/inspector_protocol:crdtp",
    "//ui/base",
    # cloud_browser_browser_main_parts.cc creates a default
    # display::ScreenBase so chromium's Screen::Get() returns non-null.
    "//ui/display",
    "//ui/gfx/geometry",
    "//url",
    # NOTE — cb_devtools_agent.cc additionally includes
    # "content/browser/compositor/surface_utils.h" (with a //nogncheck
    # marker) to call content::GetHostFrameSinkManager(). That symbol
    # lives in //content/browser:browser, whose visibility list does
    # NOT include out-of-tree consumers. The link will fail until we
    # add patches/0005-expose-host-frame-sink-manager.patch (planned —
    # see cb_devtools_agent.cc file-header note); this dep list is
    # otherwise complete and gn-check-clean.
  ]
  # Apply the repo-root include path explicitly. public_configs from
  # :encoder_factory and :framesink_capture only propagate to direct
  # consumers, not transitively through this source_set's own
  # consumers (the worker executable). T17 / Wall #20.
  configs += [ ":cb_include_paths" ]
}

# ---------------------------------------------------------------------
# The binary itself.
# ---------------------------------------------------------------------
executable("cloud_browser_worker") {
  sources = [ "cloud_browser_worker_main.cc" ]
  deps = [
    ":embedder",
    # //base brings in partition_alloc transitively, which the
    # base/memory/raw_ptr_exclusion.h facade header forwards into
    # via #include "partition_alloc/pointers/raw_ptr_exclusion.h".
    # Without this dep the worker exec compile fails with a missing-
    # include for partition_alloc/pointers/raw_ptr_exclusion.h
    # (Wall #31). Source sets like :encoder_factory get this
    # transitively through other deps; the bare exec doesn't.
    "//base",
  ]
  configs += [
    ":cb_include_paths",                           # T17.
    # Codec link-side configs. The test target lists these too. We
    # need them on the executable because GN propagates `libs` from
    # any config attached to a transitively-depended source_set, but
    # `ldflags` only propagate within the same target — encoder_factory's
    # `:x264` config gets `-lx264` onto our link line via lib propagation,
    # but the matching `-Wl,--allow-shlib-undefined` (needed for the
    # bookworm/bullseye glibc skew, see config(":x264")) is dropped
    # unless we list `:x264` here too. Same goes for :nvenc_sdk /
    # :vaapi / :svt_av1 once those profiles wire ldflags.
    ":nvenc_sdk",
    ":svt_av1",
    ":vaapi",
    ":x264",
  ]
  # cloud_browser_worker is a Linux-server binary; we don't carry mac/
  # win configs.
  if (!is_linux) {
    assert(false, "cloud_browser_worker is Linux-only (Phase 2 scope)")
  }
}

# ---------------------------------------------------------------------
# Unit tests for the encoder factory wrappers.
#
# These are gtest-based and link against //third_party/webrtc/test —
# T17's pinned branch's libwebrtc test deps. Until the build env runs,
# this is design-by-spec (matches the TODO marker in each *_test.cc).
# ---------------------------------------------------------------------
test("cloud_browser_encoder_unittests") {
  sources = [
    "../encoder/bwe_adapter_test.cc",
    "../encoder/h264_encoder_test.cc",
    "../encoder/nvenc_encoder_test.cc",
    "../encoder/simulcast_factory_test.cc",
    "../encoder/svtav1_encoder_test.cc",
    "../encoder/vaapi_encoder_test.cc",
    "../encoder/vp9_encoder_test.cc",
  ]
  deps = [
    ":encoder_factory",
    # //base/test:run_all_unittests provides main() via TestSuite —
    # required for the LINK step (Wall #37). //testing/gtest alone is
    # the framework, not the entry point.
    "//base/test:run_all_unittests",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/webrtc_overrides/cloud_browser:webrtc_api_passthrough",
    "//third_party/webrtc_overrides/cloud_browser:webrtc_test_passthrough",
  ]
  configs += [
    ":cb_include_paths",                            # T17.
    ":nvenc_sdk",
    ":svt_av1",
    ":vaapi",
    ":x264",
  ]
}

# ---------------------------------------------------------------------
# Unit tests for the FrameSink capturer (T55).
# ---------------------------------------------------------------------
test("cloud_browser_framesink_capturer_unittests") {
  sources = [ "../framesink-capturer/capturer_test.cc" ]
  deps = [
    ":framesink_capture",
    # See cloud_browser_encoder_unittests above — Wall #37. test_support
    # provides TestSuite + helpers; run_all_unittests is what supplies main().
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//media/mojo/mojom",
    # mojo::core::Init() — the test fixture's SetUp() calls this once
    # process-wide. Without it the very first
    # mojo::Remote::BindNewPipeAndPassReceiver call inside FakeProducer
    # crashes with FATAL "Mojo has not been initialized in this
    # process. You must call mojo::core::Init() as an embedder."
    # base::TestSuite (the run_all_unittests main) does NOT init Mojo
    # by default — only chromium browser-test mains do.
    "//mojo/core/embedder",
    "//mojo/public/cpp/bindings",
    "//services/viz/privileged/mojom",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx/geometry",
  ]
  configs += [ ":cb_include_paths" ]               # T17.
}
