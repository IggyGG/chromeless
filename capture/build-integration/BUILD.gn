# ---------------------------------------------------------------------
# Input DataChannel sink (M4 — CV2-41).
#
# webrtc::DataChannelObserver subclass that consumes the v1 input wire
# protocol (docs/protocols/input-channel.md) on the libwebrtc signaling
# thread and PostTask's a typed dispatch onto BrowserThread::UI. The
# delegate interface stays empty-ish for R1 (LoggingDelegate); R3 / R4 /
# R5 / R6 / R7 / R8 of M4 plug in real RWHV / Input.* / touch / drag
# injection.
#
# Standalone source_set so:
#   * the unit test target (R1 ships with cb_input_dispatch_test.cc)
#     can link only this without dragging in the full embedder set
#   * M3 R can take a clean dep on us to wire the observer into the
#     "input" DataChannel without coupling to embedder internals
# ---------------------------------------------------------------------
source_set("input_dispatch") {
  sources = [
    "cb_input_dispatch.cc",
    "cb_input_dispatch.h",
  ]
  deps = [
    "//base",
  ]

  # webrtc::DataChannelObserver + webrtc::DataBuffer live in
  # //third_party/webrtc/api:libjingle_peerconnection_api, re-exported
  # through the passthrough source_set.
  #
  # CV2-81 attempt-7 fix-forward (lesson-(g.4) Discipline-shape, BUILD.gn
  # public_deps layer — supersedes the attempt-5 deps-layer attempt that
  # mis-targeted the mechanism): this MUST be public_deps, not deps. The
  # PUBLIC header cb_input_dispatch.h #includes webrtc's
  # data_channel_interface.h, which itself #includes "api/priority.h"
  # (resolved via webrtc's public_config: -I third_party/webrtc). A plain
  # `deps` entry configures only input_dispatch's own TUs — it does NOT
  # propagate the webrtc include-dir config to targets that depend on
  # input_dispatch and include cb_input_dispatch.h. :input_dispatch_composite
  # is exactly such a consumer and (unlike the per-delegate source_sets)
  # does not pull //content/public/browser, which would otherwise carry
  # the webrtc config incidentally — so attempt-6 failed there with
  # "'api/priority.h' file not found". public_deps makes input_dispatch
  # re-export the passthrough's public_config to every consumer; that is
  # the mechanism-correct fix.
  public_deps = [
    "//third_party/webrtc_overrides/cloud_browser:webrtc_api_passthrough",
  ]
  configs += [ ":cb_include_paths" ]              # T17.
  public_configs = [ ":cb_include_paths" ]
}

test("cloud_browser_input_dispatch_unittests") {
  sources = [ "cb_input_dispatch_test.cc" ]
  deps = [
    ":input_dispatch",
    "//base/test:run_all_unittests",
    "//testing/gtest",
  ]
  configs += [ ":cb_include_paths" ]              # T17.
}

# ---------------------------------------------------------------------
# Stats relay + WebRTC event emitter (M6 R1 — CV2-33).
#
# Browser-process replacement for streamer.js's StatsRelay and
# MetricsEmitter (Wave 2 A4, chromeless commit 9850264). On the stats
# DataChannel message, forwards raw frame to
# http://localhost:9100/stats-update; on lifecycle transitions, posts
# {event, attrs} envelopes to http://localhost:9100/webrtc-event. Both
# routes are kept by M6 disposition (metrics-sidecar stays after the
# M7 streamer deletion).
#
# Standalone source_set so:
#   * the unit test target (cb_stats_relay_test.cc, follow-up R) can
#     link without dragging in the full embedder set
#   * M3 R can take a clean dep on us to wire CbStatsRelay into the
