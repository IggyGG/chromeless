    "cloud_browser_browser_main_parts.cc",
    "cloud_browser_browser_main_parts.h",
    "cloud_browser_content_client.cc",
    "cloud_browser_content_client.h",
    "cloud_browser_main.cc",
    "cloud_browser_main.h",
    "content_browser_client.cc",
    "content_browser_client.h",
  ]
  deps = [
    # M4-R2 — active streamed-WebContents resolver. main_parts owns
    # the unique_ptr and threads the raw pointer through both
    # CbDevToolsManagerDelegate (so Cb.startFrameSinkCapture can call
    # SetActiveCapture) and the M4 input dispatchers (R3..R7 take it
    # at construction).
    ":active_webcontents_resolver",
    # M1-R2 — browser-process PCF construction seam. cloud_browser_
    # browser_main_parts.cc owns 3 rtc::Threads + the pcf_ member and
    # calls CreateCloudBrowserPcf() from PreMainMessageLoopRun.
    ":cloud_browser_pcf",
    ":encoder_factory",
    ":framesink_capture",
    # CV2-69 (M55-R5-merge-with-m3-r4-r6) — native WebRTC peer runtime
    # wire. cloud_browser_browser_main_parts.cc owns:
    #   * SignalingWsClient (M3 R2) — wraps the embedder as the
    #     SignalingClientObserver, dials the broker via
    #     network::mojom::WebSocket on the browser-process network
    #     thread, forwards inbound envelopes to offerer_driver_.
    #   * CbOffererDriver (M3 R4) — owns the PeerConnection lifecycle,
    #     consumes IceConfig (M3 R3), drives the SDP+ICE dance.
    # cloud_browser_main.cc additionally calls into:
    #   * ResourceBundle init (F1, components/crash/core/common for
    #     crash keys F3, and content::InitializeMojoCore for F2) —
    #     bootstrap inits that the worker was skipping prior to CV2-69.
    ":cb_audio_lifecycle",
    ":cb_audio_options",
    ":cb_audio_track",
    ":cursor_client",
    "//cloud-browser/capture/signaling:cb_ice_config",
    "//cloud-browser/capture/signaling:cb_offerer_driver",
    "//cloud-browser/capture/signaling:cb_signaling_ws_client",
    "//cloud-browser/capture/signaling:cb_wire_envelope",
    # CV2-75 (M4/M5/M6 runtime-wire) — main_parts owns the unique_ptrs
    # for the 4 consumer classes that bind to the F7-skinny DCs.
    # CbCursorClient is part of the embedder source_set itself
    # (cb_cursor_client.cc is in this target's `sources`), so no new
    # dep needed for it. Stats relay (M6 R1) is deferred — needs a
    # 5th "stats" DC that doesn't exist in current F7-skinny.
    ":clipboard_relay",
    ":file_upload_relay",
    ":input_dispatch",
    # Browser-fidelity wave 1 — the guest's ask-a-human path. main_parts
    # owns the CbControlChannel unique_ptr and binds it to the kControl DC
    # alongside the other consumers; the dialog manager hangs off the
    # WebContentsDelegate and is handed the channel per session.
    #
    # Wired into :embedder in the SAME change that adds the source_sets,
    # deliberately: this target is where these files first get compiled,
    # and landing them as unreferenced deadweight would defer every
    # signature error to whichever later change happened to add the dep
    # (the 9d33276 lesson — see the :cb_audio_* comment block above).
    ":control_channel",
    ":javascript_dialog_manager",
    ":web_contents_delegate",
    # CV2-81 — M4 typed-dispatcher composite delegate. Transitively
    # pulls all 6 typed dispatchers (R3 mouse / R4 keyboard / R5 IME /
    # R6 touch / R7 drag / R8 clipboard) + the M4 R2 active-WebContents
    # resolver (declared via :active_webcontents_resolver above).
    # main_parts owns the unique_ptr; ctor takes the resolver pointer.
    ":input_dispatch_composite",
    ":cursor_xy_join",
    "//cloud-browser/capture/cursor:cb_cursor_emit_policy",
    "//cloud-browser/capture/cursor:cb_cursor_dc_emitter",
    "//cloud-browser/capture/cursor:cb_cursor_envelope",
    # CV2-83 — CbHeadlessScreen reads the M4 R10 last-pointer state
    # directly after CV2-81 installs the typed mouse dispatcher as
    # runtime source. Direct dep keeps GN header ownership explicit.
    ":pointer_state",
    "//cloud-browser/capture/signaling:cb_dc_host",
    # CV2-69 F1 + F3 — chromium-subsystem bootstrap inits the embedder
    # was skipping (gpu-test-lead audit /tmp/cv2-embedder-init-audit.md).
    # F1 (ResourceBundle) lives in //ui/base already in this list;
    # F3 (crash keys) is the only new dep.
    "//components/crash/core/common:crash_key",
    "//base",
    # cloud_browser_browser_context.cc registers with the
    # BrowserContext / Simple keyed-service dependency managers (same
    # shape every chromium embedder uses; see
    # content/shell/browser/shell_browser_context.cc and
    # headless/lib/browser/headless_browser_context_impl.cc for the
    # canonical templates).
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    # cb_devtools_agent.cc uses inspector_protocol's CBOR + dispatch
    # primitives to parse the incoming Cb.* command and emit the
    # response. crdtp is the same library every upstream embedder
    # delegate (content_shell + headless) uses for the same job.
    "//components/viz/common",
    "//components/viz/host",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//media",
    "//mojo/public/cpp/bindings",
    # cloud_browser_browser_main_parts.cc opens a TCPServerSocket on
    # the loopback for the DevTools HTTP listener — same shape every
    # other chromium embedder uses (content_shell, headless).
    "//net",
    "//services/viz/privileged/mojom",
    "//third_party/inspector_protocol:crdtp",
    # BUGS-529 second-layer — cb_aura_platform_data + cb_focus_client +
    # cb_window_parenting_client wire the Aura subsystem so WebContents
    # the embedder creates get parented into a real focus chain. Real
    # ozone-X11-backed WindowTreeHost (cb-chromium runs Xvfb on :99 +
    # --ozone-platform=x11). Mirrors content_shell's
    # ShellPlatformDataAura pattern minus the ui/aura:test_support
    # dependency (testonly = true; not consumable from a non-test
    # executable). Focus + parenting clients are roll-our-own copies of
    # the headless versions.
    "//ui/aura",
    "//ui/base",
    # cb_begin_frame_driver.cc + cb_aura_platform_data.cc use ui::Compositor
    # (IssueExternalBeginFrame / use_external_begin_frame_control() and the
    # WindowTreeHostPlatform CreateCompositor external-begin-frame path — the
    # CV2-ICE ~0.5fps capture-starvation fix). The direct
    # #include "ui/compositor/compositor.h" needs the direct dep.
    "//ui/compositor",
    # cloud_browser_browser_main_parts.cc creates a CbHeadlessScreen
    # (display::ScreenBase subclass) so chromium's Screen::Get() returns
    # non-null AND aura's pre-SetCursor gate (IsWindowUnderCursor) does
    # not short-circuit cursor routing — see cb_headless_screen.h.
    "//ui/display",
    # cloud_browser_content_client.cc includes ui/gfx/image/image.h for the
    # gfx::Image& return type of GetNativeImageNamed (gn check requires the
    # direct dep for the directly-included header).
    "//ui/gfx",
    "//ui/gfx/geometry",
    # PlatformWindowInitProperties — passed to aura::WindowTreeHost::
    # Create() to give the host an initial bounds.
    "//ui/platform_window",
    # wm::DefaultActivationClient — registered on the root window so
    # Aura activation routing works for the WebContents we attach.
    "//ui/wm",
    "//url",
    # NOTE — cb_devtools_agent.cc additionally includes
    # "content/browser/compositor/surface_utils.h" (with a //nogncheck
    # marker) to call content::GetHostFrameSinkManager(). That symbol
    # lives in //content/browser:browser, whose visibility list does
    # NOT include out-of-tree consumers. The link will fail until we
    # add patches/0005-expose-host-frame-sink-manager.patch (planned —
    # see cb_devtools_agent.cc file-header note); this dep list is
    # otherwise complete and gn-check-clean.
  ]
  # Apply the repo-root include path explicitly. public_configs from
  # :encoder_factory and :framesink_capture only propagate to direct
  # consumers, not transitively through this source_set's own
  # consumers (the worker executable). T17 / Wall #20.
  configs += [ ":cb_include_paths" ]
}

# ---------------------------------------------------------------------
# The binary itself.
# ---------------------------------------------------------------------
executable("cloud_browser_worker") {
  sources = [ "cloud_browser_worker_main.cc" ]
  deps = [
    ":embedder",
    # //base brings in partition_alloc transitively, which the
    # base/memory/raw_ptr_exclusion.h facade header forwards into
    # via #include "partition_alloc/pointers/raw_ptr_exclusion.h".
    # Without this dep the worker exec compile fails with a missing-
    # include for partition_alloc/pointers/raw_ptr_exclusion.h
    # (Wall #31). Source sets like :encoder_factory get this
    # transitively through other deps; the bare exec doesn't.
    "//base",
  ]
  configs += [
    ":cb_include_paths",                           # T17.
    # Codec link-side configs. The test target lists these too. We
    # need them on the executable because GN propagates `libs` from
    # any config attached to a transitively-depended source_set, but
    # `ldflags` only propagate within the same target — encoder_factory's
    # `:x264` config gets `-lx264` onto our link line via lib propagation,
    # but the matching `-Wl,--allow-shlib-undefined` (needed for the
    # bookworm/bullseye glibc skew, see config(":x264")) is dropped
    # unless we list `:x264` here too. Same goes for :nvenc_sdk /
    # :vaapi / :svt_av1 once those profiles wire ldflags.
    ":nvenc_sdk",
    ":svt_av1",
    ":vaapi",
    ":x264",
  ]
  # cloud_browser_worker is a Linux-server binary; we don't carry mac/
  # win configs.
  if (!is_linux) {
    assert(false, "cloud_browser_worker is Linux-only (Phase 2 scope)")
  }
}

