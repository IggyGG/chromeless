# gn args for the cloud-browser worker (Phase 2).
#
# This file is the single source of truth for our build configuration.
# It mirrors the recommended args from docs/build/chromium-from-source.md
# §2 (T17) — keep that doc and this file aligned at every roll.
#
# TODO(T17-build-env): exercise this on a Linux box with depot_tools.
# Until then, treat as design-by-spec.
#
# Use:
#   gn gen out/cb-release \
#       --args='import("//cloud-browser/capture/build-integration/args.gn")'

# ---- Mode ------------------------------------------------------------
is_debug                 = false
is_official_build        = false   # `true` is for shipping artifacts;
                                    # ours is a server worker.
is_component_build       = false   # one binary, simpler deploy.
# CV2 2026-06-30: dcheck_always_on defaults to !is_official_build in
# Chromium, so with is_official_build=false the guest renderer ships with
# FATAL DCHECKs ACTIVE. Proven in staging: 7/7 cb-chromium guests across the
# fleet SIGABRT'd on `DCHECK failed: default_svg_style_->...`
# (css_default_style_sheets.cc:185) while rendering — a non-fatal assertion
# production Chrome tolerates — producing 0 frames and tearing down the
# WebRTC FrameSink session ("native FrameSink capture failed to start").
# Force it off so guests don't abort on debug-only assertions; keep
# is_official_build false for build speed.
dcheck_always_on         = false

# ---- Symbols / size --------------------------------------------------
symbol_level             = 1       # crash-grade only; level-2 ~doubles
                                    # disk and we don't ship as a
                                    # debugger target.
blink_symbol_level       = 0
v8_symbol_level          = 0
strip_debug_info         = false   # leave for now; revisit when we ship.

# ---- Trim ------------------------------------------------------------
enable_nacl              = false
enable_widevine          = false
enable_remoting          = false   # we are remoting; we don't need
                                    # Chromium's own remoting subsystem.
use_cups                 = false
optimize_webui           = true

# ---- Codecs (in-page playback + our encoder factory) ----------------
proprietary_codecs       = true
ffmpeg_branding          = "Chrome"
rtc_use_h264             = true
rtc_include_tests        = false
enable_libaom            = true
enable_dav1d_decoder     = true

# ---- Audio Device Module --------------------------------------------
# webrtc/api/audio:create_audio_device_module + the AudioDeviceModuleImpl
# gn targets only register when this flag is true. Default is
# !build_with_chromium = false in chromium builds; webrtc expects
# chromium embedders to provide their own ADM via the audio service.
# For our M1 PCF placeholder ADM (kDummyAudio via
# webrtc::CreateAudioDeviceModule), we DO need the webrtc internal
# implementation linked in. Set to true to make the symbol available.
# M5.5 ships the real Pulse-based ADM; this flag stays true since
# that path also uses webrtc::AudioDeviceModuleImpl under the hood.
rtc_include_internal_audio_device = true

# CV2-75 Ring 3 — activate the PulseAudio backend in WebRTC's Linux ADM
# factory. Without this flag, third_party/webrtc/webrtc.gni:278 declares
# `rtc_include_pulse_audio = !build_with_chromium`, which is FALSE for
# our chromium-bundled libwebrtc build. That causes audio_device/BUILD.
# gn:357-358 to skip the WEBRTC_ENABLE_LINUX_PULSE define, and
# audio_device_impl.cc:201-209 takes the ALSA-only branch:
#
#   WARNING: audio_device_impl.cc:205 PulseAudio is disabled using build flag.
#   ERROR:   audio_device_alsa_linux.cc:618 device index is out of range [0,-1]
#   ERROR:   adm_helpers.cc:44 Unable to set playout device.
#
# (Empirical evidence from baseline-rv1 cb-chromium logs, surfaced by
# functional-test-lead via cheap-preview log grep, 2026-05-19. M5.5 R0
# acceptance: absence of the disable-warning + ALSA-out-of-range pair.)
#
# CV2-75 Ring 3 v2 fix-forward (post-rv2 FAIL): the flag is
# `rtc_include_pulse_audio`, NOT `rtc_use_pulse_audio` (the latter does
# not exist in webrtc.gni — the prior version of this line was a no-op).
# Verified by direct grep of webrtc.gni:278 + BUILD.gn:357 +
# audio_device_impl.cc:196 ("'rtc_include_pulse_audio' build flag")
# against chromium-7727's chromium-src on T7.
#
# This is a runtime-only gate — symbols compile fine either way; the
# failure only manifests when an audio-track is requested. PipeWire
# (rtc_use_pipewire) and the dummy-audio path
# (rtc_use_dummy_audio_file_devices) default to false in WebRTC's
# build conventions, so no sibling enable/disable is needed. No
# chromium-side `use_pulseaudio` flag is needed either — that gates
# chromium's media/audio/audio_manager_pulse.cc which our worker
# doesn't use (cb_audio_device_module.cc calls
# webrtc::CreateAudioDeviceModule directly, bypassing chromium's
# content/media audio_service abstraction).
rtc_include_pulse_audio = true

# ---- Headless / server-shaped ---------------------------------------
use_ozone                = true
ozone_platform_headless  = true
ozone_platform_x11       = true    # Phase 1 still uses Xvfb.
ozone_platform_wayland   = false

# ---- V8 snapshot -----------------------------------------------------
# Embed the V8 startup snapshot in the binary instead of loading
# snapshot_blob.bin at runtime. Avoids base::DIR_ASSETS path-
# resolution fragility for the standalone worker binary (which
# doesn't ship under a chromium framework bundle on Linux). Costs
# ~3 MiB on the stripped binary; trade is worth it for runtime
# robustness.
v8_use_external_startup_data = false

# ---- Toolchain -------------------------------------------------------
treat_warnings_as_errors = false   # rolls hurt less.
clang_use_chrome_plugins = true
use_sysroot              = true

# ---- Build cache (per docs/build/chromium-from-source.md §5) --------
# Set when sccache is on the PATH. Uncomment in CI / build hosts:
# cc_wrapper             = "sccache"
