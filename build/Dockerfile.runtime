# build/Dockerfile.runtime — Phase 2 runtime image.
#
# This is the chromeless image once T112+T113 ship cloud_browser_worker.
# Replaces the v1 stock-Chromium-under-Xvfb shape (current
# infra/Dockerfile) with our embedder binary that ships the encoder
# factory (T19 / T35 / T36 / T58 / T63 / T70 / T75 / T83) + the
# FrameSinkVideoCapturer integration (T55) compiled in.
#
# The kaniko sidecar in the K8s build Job (T112) reads this from
# the build context staged at /work/artifacts/context/ by Step 9 of
# chromeless-build.sh and pushes the result to the forgejo registry tagged
# `chromeless:cr<branch>-<sha>` (per the IMAGE_TAG file in the
# context).
#
# Coexistence with infra/Dockerfile:
#   - infra/Dockerfile builds the Phase 1 image (stock chromium +
#     getDisplayMedia, T7 / T78 / T86's CHROMELESS_USE_FAKE_MEDIA path).
#     That image stays the dev compose default until Phase 2 lands.
#   - This Dockerfile builds the Phase 2 image (cloud_browser_worker
#     embedder, real FrameSinkVideoCapturer, real encoder factory).
#     Compose flips when T101 §6 first-real-demo gate clears.

# debian:trixie-slim is consistent with the v1 image base (T7) and
# gives us the runtime libs every Chromium build links against —
# libnss, libgbm, libfontconfig, libdbus, fonts. Distroless would be
# smaller but the runtime needs more libs than distroless ships, and
# debugging is much easier with apt available.
FROM debian:trixie-slim

# Same supervisord-driven structure as the Phase 1 image (T7) so
# the rest of infra/ keeps working without per-image conditionals.
# hadolint ignore=DL3008
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        ca-certificates \
        dumb-init \
        supervisor \
        xvfb \
        pulseaudio \
        pulseaudio-utils \
        socat \
        # Chromium runtime deps — every cloud_browser_worker links
        # against these since they live in third_party/. If T17's
        # build env grows new deps, append here in lock-step.
        libnss3 \
        libnspr4 \
        libgbm1 \
        libdbus-1-3 \
        libdrm2 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libxkbcommon0 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
        libatspi2.0-0 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libfontconfig1 \
        libfreetype6 \
        fonts-noto-core \
        fonts-noto-color-emoji \
        # Diagnostic tools — same set the Phase 1 image carries (T9,
        # T52). The container is debugged via DevTools but having
        # curl + xdpyinfo + procps in the image saves an exec the
        # one time it actually breaks.
        curl \
        procps \
        x11-utils \
        # supervisord watchdog (T16-followup). python3 + websocket
        # client are required by infra/lifecycle/idle-watchdog.sh.
        python3 \
        python3-websocket \
        && rm -rf /var/lib/apt/lists/*

# cbuser matches the Phase 1 image so file ownership semantics are
# consistent across the two images. UID 1000 lines up with the K8s
# securityContext we ship in browsersessionpool-examples.yaml.
RUN groupadd --gid 1000 cbuser && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash cbuser && \
    mkdir -p /run/user/1000/pulse \
             /run/supervisor \
             /run/chromeless-session \
             /home/cbuser/.config/chromium \
             /var/log/supervisor \
             /opt/cloud-browser && \
    chown -R cbuser:cbuser /run/user/1000 /run/supervisor /run/chromeless-session /home/cbuser /var/log/supervisor /opt/cloud-browser && \
    chmod 0700 /run/user/1000

# The actual binary. Built by chromeless-build.sh (T113) from the pinned
# Chromium tree + our patch series + our cloud-browser sources.
# Copy from the kaniko build context.
COPY cloud_browser_worker /usr/local/bin/chromeless
RUN chmod +x /usr/local/bin/chromeless && \
    ln -sf /usr/local/bin/chromeless /usr/local/bin/cloud_browser_worker

# Chromium runtime data files. args.gn sets
# v8_use_external_startup_data=false, so V8's snapshot is embedded in
# the worker binary; snapshot_blob.bin is intentionally not required.
# ICU data is not embedded by default and is loaded from icudtl.dat at
# runtime via base::PathService::Get(base::DIR_ASSETS) which resolves
# to the binary's directory. Without it the worker exits at startup
# with `Check failed: result. ` from base/i18n/icu_util.cc:306.
#
# libEGL.so / libGLESv2.so / libvk_swiftshader.so / libvulkan.so.1
# ship the Angle + SwiftShader bits the worker uses for `--use-gl=angle
# --use-angle=swiftshader-webgl`; without them the GL backend can't
# load and the renderer crashes during compositor init.
#
# All of these are staged into the build context by chromeless-build.sh
# Step 9 alongside cloud_browser_worker. They live next to the
# binary in /usr/local/bin/ so chromium's default PathService
# resolution finds them without an extra `--icu-data-dir` flag.
COPY icudtl.dat            /usr/local/bin/icudtl.dat
COPY libEGL.so             /usr/local/bin/libEGL.so
COPY libGLESv2.so          /usr/local/bin/libGLESv2.so
COPY libvk_swiftshader.so  /usr/local/bin/libvk_swiftshader.so

# rv8: chromium's bundled Vulkan loader. LOAD-BEARING and must sit in
# /usr/local/bin/ next to the ANGLE libs.
#
# chromium's ANGLE is built with ANGLE_USE_CUSTOM_LIBVULKAN
# (third_party/angle/src/common/vulkan/BUILD.gn) + angle_shared_libvulkan
# (true on Linux). At GPU-process init, ANGLE's vk::Renderer::initialize
# calls angle::vk::OpenLibVulkan() (vk_renderer.cpp:2431). OpenLibVulkan
# (third_party/angle/src/common/vulkan/libvulkan_loader.cpp) — under
# ANGLE_USE_CUSTOM_LIBVULKAN — searches ONLY SearchType::ModuleDir for
# `libvulkan.so` / `libvulkan.so.1`; it does NOT fall back to the system
# library path. The module dir is wherever libGLESv2.so loaded from —
# /usr/local/bin/ here. If libvulkan.so.1 is not there, OpenLibVulkan
# returns NULL and vk_renderer.cpp:2432 ANGLE_VK_CHECK fails with
# VK_ERROR_INITIALIZATION_FAILED (-3) BEFORE any ICD scan — surfacing as
# `ANGLE Display::initialize error: Internal Vulkan error (-3)` →
# `eglInitialize SwANGLE failed` → `Exiting GPU process`.
#
# The Debian libvulkan1 package's loader at /usr/lib/x86_64-linux-gnu/
# is NOT consulted (ANGLE_USE_CUSTOM_LIBVULKAN disables the SystemDir
# search). chromium's build emits its own loader at
# ${OUT_DIR}/libvulkan.so.1; chromeless-build.sh Step 8 stages it.
#
# rv7/rv8-attempt-1 missed this: CV2-89 + rv8-attempt-1 fixed the ICD
# descriptor (registration + path), but that ring is downstream of
# OpenLibVulkan — never reached while the loader itself is absent.
COPY libvulkan.so.1        /usr/local/bin/libvulkan.so.1

# CV2-89 + rv8: SwANGLE Vulkan ICD descriptor JSON — co-located
# with the ANGLE libraries.
#
# libvk_swiftshader.so above is the SwiftShader Vulkan driver
# (chromium-shipped, ~25 MB pure-software CPU-rendered Vulkan
# emulation). The Vulkan loader needs an ICD descriptor JSON to
# discover that driver; without a *reachable* JSON, vkCreateInstance
# returns VK_ERROR_INITIALIZATION_FAILED ("Internal Vulkan error
# (-3)"), which propagates as `eglInitialize SwANGLE failed with
# error EGL_NOT_INITIALIZED` and `Exiting GPU process due to errors
# during initialization`. Renderer dies, DOM never lays out, Aura
# cursor routing path never fires.
#
# THE PATH IS LOAD-BEARING — it MUST be /usr/local/bin/, not the
# distribution-conventional /usr/share/vulkan/icd.d/. chromium's
# ANGLE SwANGLE path does NOT use the Vulkan loader's generic ICD
# scan directory. ANGLE (third_party/angle/src/common/vulkan/
# vulkan_icd.cpp, ScopedVkLoaderEnvironment for vk::ICD::SwiftShader)
# SELF-SETS the VK_ICD_FILENAMES env var to
# WrapICDEnvironment(ANGLE_VK_SWIFTSHADER_ICD_JSON) =
# <ANGLE module dir>/vk_swiftshader_icd.json. The ANGLE module dir
# is wherever libGLESv2.so / libEGL.so are loaded from — i.e.
# /usr/local/bin/ in this image. Once VK_ICD_FILENAMES is set the
# Vulkan loader uses ONLY the file(s) it names and SKIPS the generic
# /usr/share/vulkan/icd.d/ scan entirely. So the JSON must sit at
# /usr/local/bin/vk_swiftshader_icd.json, next to the ANGLE libs.
#
# rv8 (CV2-89 ring-N+1): CV2-89 first staged this JSON at
# /usr/share/vulkan/icd.d/ — correct for a generic Vulkan app that
# uses the loader's default scan, but never consulted by chromium's
# SwANGLE because ANGLE's VK_ICD_FILENAMES override disables that
# scan. vkCreateInstance still failed -3 with the JSON present but
# unreachable. rv8 moves it to the ANGLE-module directory.
#
# The JSON is generated by chromium's build at
# ${OUT_DIR}/vk_swiftshader_icd.json alongside libvk_swiftshader.so.
# chromeless-build.sh STEP 8 copies it into the kaniko context and
# sed-rewrites `library_path` to the absolute
# /usr/local/bin/libvk_swiftshader.so (valid regardless of the
# JSON's own location; here the lib and JSON are in fact co-located
# so a relative path would also resolve).
#
# Methodology: lesson-(i) ring cascade. CV2-89 fixed "ICD JSON not
# staged at all"; rv8 fixes "ICD JSON staged at a path chromium's
# SwANGLE never reads" — component-present != reachable-in-this-
# environment.
COPY vk_swiftshader_icd.json /usr/local/bin/vk_swiftshader_icd.json

# Runtime glue staged by chromeless-build.sh Step 9. M7: native peer
# instantiates the PeerConnection in cloud_browser_main_parts.cc; no
# in-container streamer page or static page server. Pod-level
# metrics/event export remains on the explicit K8s sidecar.
COPY pulse-default.pa     /etc/pulse/default.pa
COPY supervisord.conf      /etc/supervisor/supervisord.conf
COPY launch-chromeless.sh    /usr/local/bin/launch-chromeless.sh
COPY devtools-proxy.sh      /usr/local/bin/devtools-proxy.sh
COPY lifecycle/ /usr/local/lib/cloud-browser/lifecycle/
RUN ln -sf /usr/local/lib/cloud-browser/lifecycle/entrypoint.sh    /usr/local/bin/entrypoint.sh && \
    ln -sf /usr/local/lib/cloud-browser/lifecycle/cold-start.sh    /usr/local/bin/cold-start.sh && \
    ln -sf /usr/local/lib/cloud-browser/lifecycle/restart.sh       /usr/local/bin/restart.sh && \
    chmod +x /usr/local/lib/cloud-browser/lifecycle/*.sh && \
    chmod +x /usr/local/bin/launch-chromeless.sh /usr/local/bin/devtools-proxy.sh && \
    chown -R cbuser:cbuser /opt/cloud-browser

# Image-tag metadata for runtime introspection. The kaniko sidecar
# injects the same value here so `docker inspect` and
# `cloud_browser_worker --version` both report the same id.
ARG IMAGE_TAG=unknown
ENV CHROMELESS_IMAGE_TAG=${IMAGE_TAG}
LABEL org.opencontainers.image.source="https://github.com/iggy/chromeless"
LABEL org.opencontainers.image.title="chromeless"
LABEL org.opencontainers.image.description="Phase 2 cloud-browser worker — embedder Chromium with encoder factory + FrameSinkVideoCapturer."
LABEL org.opencontainers.image.version="${IMAGE_TAG}"

# Same network surface as the Phase 1 image: 9222 = DevTools (T9 /
# T52 socat sidecar territory), 9100 = chromeless-metrics-sidecar (T38).
EXPOSE 9222 9100

# /dev/shm sizing matters here too — Chromium's renderer needs more
# than the 64 MiB Docker default. The compose / K8s spec sets
# shm_size=1gb; --disable-dev-shm-usage in launch-chromeless.sh is the
# belt-and-braces fallback (T7 / T78).
HEALTHCHECK --interval=10s --timeout=3s --start-period=45s --retries=3 \
    CMD curl -fsS http://127.0.0.1:9222/json/version || exit 1

USER cbuser
WORKDIR /home/cbuser

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/entrypoint.sh"]
