+// M2-R5 — capture lifecycle tests.
+//
+// These extend the unittest target that R3 introduces; the fixture,
+// fake capturer, fake sink, and helper builders below are R5
+// contributions to that target. If R3 already provides any of them
+// under a different name, the duplicate definitions are dropped during
+// the R5/R3 fold-in (TODO(M2-R5-test-helpers)).
+
+namespace cloud_browser {
+namespace {
+
+// Minimal viz FrameSinkVideoCapturer fake; counts Start/Stop, never
+// drives the consumer on its own (tests drive OnFrameCaptured directly
+// via the receiver Remote returned from BindNewPipeAndPassReceiver()).
+class FakeFrameSinkVideoCapturer : public viz::mojom::FrameSinkVideoCapturer {
+ public:
+  FakeFrameSinkVideoCapturer() = default;
+  ~FakeFrameSinkVideoCapturer() override = default;
+
+  size_t start_count() const { return start_count_; }
+  size_t stop_count() const { return stop_count_; }
+
+  // viz::mojom::FrameSinkVideoCapturer:
+  void Start(mojo::PendingRemote<viz::mojom::FrameSinkVideoConsumer> consumer,
+             viz::mojom::BufferFormatPreference /*format*/) override {
+    ++start_count_;
+    consumer_.Bind(std::move(consumer));
+  }
+  void Stop() override {
+    ++stop_count_;
+    consumer_.reset();
+  }
+  // ... boilerplate no-ops for the rest of the mojom (set_resolution,
+  // set_format, set_animation_fps, ...). TODO(M2-R5-fake-impl): cribbed
+  // from viz's own test_frame_sink_video_capturer in the chromium tree.
+
+ private:
+  size_t start_count_ = 0u;
+  size_t stop_count_ = 0u;
+  mojo::Remote<viz::mojom::FrameSinkVideoConsumer> consumer_;
+};
+
+class FakeVideoSink : public rtc::VideoSinkInterface<webrtc::VideoFrame> {
+ public:
+  void OnFrame(const webrtc::VideoFrame& /*frame*/) override {
+    ++frame_count_;
+  }
+  size_t frame_count() const { return frame_count_; }
+
+ private:
+  size_t frame_count_ = 0u;
+};
+
+}  // namespace
+
+class CbFrameSinkVideoTrackSourceLifecycleTest
+    : public CbFrameSinkVideoTrackSourceTest /* R3 base fixture */ {
+ protected:
+  // Accessors plumbed via friend declaration on the source class
+  // (R3 already declares CbFrameSinkVideoTrackSourceTest a friend so
+  // we can poke at producer_ / consumer_receiver_ from tests).
+  FakeFrameSinkVideoCapturer& fake_capturer() { return fake_capturer_; }
+
+ private:
+  FakeFrameSinkVideoCapturer fake_capturer_;
+};
+
+// Acceptance #1: producer_->Start NOT called and no frame reaches a
+// sink until first sink attaches.
+TEST_F(CbFrameSinkVideoTrackSourceLifecycleTest,
+       ProducerNotStartedWithoutSink) {
+  auto source = MakeSource();
+  RunAllPendingCapturerTasks();
+
+  EXPECT_EQ(fake_capturer().start_count(), 0u);
+  EXPECT_EQ(fake_capturer().stop_count(), 0u);
+}
+
+TEST_F(CbFrameSinkVideoTrackSourceLifecycleTest,
+       FirstSinkStartsProducer) {
+  auto source = MakeSource();
+  FakeVideoSink sink;
+
+  source->AddOrUpdateSink(&sink, rtc::VideoSinkWants());
+  RunAllPendingCapturerTasks();
+
+  EXPECT_EQ(fake_capturer().start_count(), 1u);
+  EXPECT_EQ(fake_capturer().stop_count(), 0u);
+}
+
+TEST_F(CbFrameSinkVideoTrackSourceLifecycleTest,
+       SecondSinkDoesNotRestartProducer) {
+  auto source = MakeSource();
+  FakeVideoSink sink_a;
+  FakeVideoSink sink_b;
+
+  source->AddOrUpdateSink(&sink_a, rtc::VideoSinkWants());
+  source->AddOrUpdateSink(&sink_b, rtc::VideoSinkWants());
+  RunAllPendingCapturerTasks();
+
+  EXPECT_EQ(fake_capturer().start_count(), 1u);
+  EXPECT_EQ(fake_capturer().stop_count(), 0u);
+}
+
+TEST_F(CbFrameSinkVideoTrackSourceLifecycleTest,
+       LastSinkRemovalStopsProducer) {
+  auto source = MakeSource();
+  FakeVideoSink sink_a;
+  FakeVideoSink sink_b;
+
+  source->AddOrUpdateSink(&sink_a, rtc::VideoSinkWants());
+  source->AddOrUpdateSink(&sink_b, rtc::VideoSinkWants());
+  RunAllPendingCapturerTasks();
+  source->RemoveSink(&sink_a);
+  RunAllPendingCapturerTasks();
+
+  EXPECT_EQ(fake_capturer().stop_count(), 0u);  // sink_b still attached.
+
+  source->RemoveSink(&sink_b);
+  RunAllPendingCapturerTasks();
+
+  EXPECT_EQ(fake_capturer().stop_count(), 1u);
+}
+
+// Acceptance #2: after last detach, producer_->Stop called and Done()
+// fired for every in-flight buffer (no pool leak).
+TEST_F(CbFrameSinkVideoTrackSourceLifecycleTest,
+       StopFiresDoneForInFlightBuffers) {
+  auto source = MakeSource();
+  FakeVideoSink sink;
+
+  source->AddOrUpdateSink(&sink, rtc::VideoSinkWants());
+  RunAllPendingCapturerTasks();
+
+  // Deliver two frames via the source's FrameSinkVideoConsumer impl,
+  // each carrying a Done-callback Remote we keep so we can assert
+  // Done() was fired. RegisterInFlightCallback() is a R3 testing helper
+  // that pushes onto in_flight_done_callbacks_ keyed by buffer_id.
+  // TODO(M2-R5-done-fakes): if R3 doesn't expose that helper, replace
+  // with a direct mojo::AssociatedReceiver wired to a FakeFrameCallbacks
+  // implementing FrameSinkVideoConsumerFrameCallbacks::Done.
+  auto callbacks_a = RegisterInFlightCallback(source.get(), /*buffer_id=*/1);
+  auto callbacks_b = RegisterInFlightCallback(source.get(), /*buffer_id=*/2);
+  RunAllPendingCapturerTasks();
+
+  source->RemoveSink(&sink);
+  RunAllPendingCapturerTasks();
+
+  EXPECT_EQ(fake_capturer().stop_count(), 1u);
+  EXPECT_TRUE(callbacks_a.done_was_called());
+  EXPECT_TRUE(callbacks_b.done_was_called());
+}
+
+// Idempotency: 0->1->0->1 must result in Start(2) / Stop(1), not
+// blow up an internal DCHECK on capturer_running_.
+TEST_F(CbFrameSinkVideoTrackSourceLifecycleTest,
+       RestartAfterStopIsIdempotent) {
+  auto source = MakeSource();
+  FakeVideoSink sink;
+
+  source->AddOrUpdateSink(&sink, rtc::VideoSinkWants());
+  source->RemoveSink(&sink);
+  source->AddOrUpdateSink(&sink, rtc::VideoSinkWants());
+  RunAllPendingCapturerTasks();
+
+  EXPECT_EQ(fake_capturer().start_count(), 2u);
+  EXPECT_EQ(fake_capturer().stop_count(), 1u);
+}
+
+// Race-safety: rapid 0->1->0->1->0 on the WebRTC worker thread must
+// serialize cleanly on the capturer sequence — Start/Stop counters
+// reflect the *posted* order, not a per-thread interleaving.
+TEST_F(CbFrameSinkVideoTrackSourceLifecycleTest,
+       RapidToggleSerializedOnCapturerSequence) {
+  auto source = MakeSource();
+  FakeVideoSink sink;
+
+  source->AddOrUpdateSink(&sink, rtc::VideoSinkWants());
+  source->RemoveSink(&sink);
+  source->AddOrUpdateSink(&sink, rtc::VideoSinkWants());
+  source->RemoveSink(&sink);
+  RunAllPendingCapturerTasks();
+
+  EXPECT_EQ(fake_capturer().start_count(), 2u);
+  EXPECT_EQ(fake_capturer().stop_count(), 2u);
+}
+
+}  // namespace cloud_browser
