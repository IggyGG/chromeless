+#include "base/check_op.h"
+#include "base/functional/bind.h"
+#include "base/task/sequenced_task_runner.h"
+#include "services/viz/public/mojom/compositing/frame_sink_video_capture.mojom.h"
+
 // ... R3 includes + ctor/dtor + OnFrameCaptured impl ...

+// M2-R5 — sink-attachment-driven capture lifecycle.
+//
+// AddOrUpdateSink / RemoveSink are called from arbitrary webrtc threads
+// (worker, signaling). We forward to the base immediately so the frame
+// fan-out keeps working, then bounce the lifecycle decision onto the
+// capturer sequence so producer_'s mojo Remote and sink_count_ are
+// only ever touched on one sequence.
+
+void CbFrameSinkVideoTrackSource::AddOrUpdateSink(
+    rtc::VideoSinkInterface<webrtc::VideoFrame>* sink,
+    const rtc::VideoSinkWants& wants) {
+  rtc::AdaptedVideoTrackSource::AddOrUpdateSink(sink, wants);
+
+  capturer_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<CbFrameSinkVideoTrackSource> self) {
+            if (!self) {
+              return;
+            }
+            DCHECK_CALLED_ON_VALID_SEQUENCE(
+                self->capturer_sequence_checker_);
+            ++self->sink_count_;
+            if (self->sink_count_ == 1u && !self->capturer_running_) {
+              self->OnFirstSinkAddedOnCapturerSequence();
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+void CbFrameSinkVideoTrackSource::RemoveSink(
+    rtc::VideoSinkInterface<webrtc::VideoFrame>* sink) {
+  rtc::AdaptedVideoTrackSource::RemoveSink(sink);
+
+  capturer_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<CbFrameSinkVideoTrackSource> self) {
+            if (!self) {
+              return;
+            }
+            DCHECK_CALLED_ON_VALID_SEQUENCE(
+                self->capturer_sequence_checker_);
+            DCHECK_GT(self->sink_count_, 0u);
+            --self->sink_count_;
+            if (self->sink_count_ == 0u && self->capturer_running_) {
+              self->OnLastSinkRemovedOnCapturerSequence();
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+void CbFrameSinkVideoTrackSource::OnFirstSinkAddedOnCapturerSequence() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(capturer_sequence_checker_);
+  DCHECK(!capturer_running_);
+  DCHECK(producer_.is_bound());
+
+  // Bind ourselves as the FrameSinkVideoConsumer for the upcoming session.
+  // The Receiver lives on capturer_task_runner_, so OnFrameCaptured()
+  // dispatches there and we never cross-thread the frame pump.
+  //
+  // TODO(M2-R5-consumer-binding): if R3 binds consumer_receiver_ in its
+  // ctor (rather than per-session), drop the Bind() call here and just
+  // pass `consumer_receiver_.BindNewPipeAndPassRemote()` once at ctor
+  // time. Per-session binding (current shape) is preferable because
+  // Stop()+reset() guarantees no stale OnFrameCaptured arrives during
+  // the idle window.
+  mojo::PendingRemote<viz::mojom::FrameSinkVideoConsumer> consumer_remote;
+  consumer_receiver_.Bind(
+      consumer_remote.InitWithNewPipeAndPassReceiver(),
+      capturer_task_runner_);
+
+  producer_->Start(std::move(consumer_remote),
+                   viz::mojom::BufferFormatPreference::kDefault);
+  capturer_running_ = true;
+}
+
+void CbFrameSinkVideoTrackSource::OnLastSinkRemovedOnCapturerSequence() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(capturer_sequence_checker_);
+  DCHECK(capturer_running_);
+
+  // Stop the producer FIRST so no further OnFrameCaptured calls land
+  // after we drain the in-flight map. The viz capturer treats Stop()
+  // as a hint that more frames may already be in flight on the consumer
+  // side; closing consumer_receiver_ below converts that into a hard
+  // EOF for the consumer pipe.
+  producer_->Stop();
+  capturer_running_ = false;
+  consumer_receiver_.reset();
+
+  // Drain in-flight Done() callbacks so the viz pool can recycle every
+  // shared-image we ever held. Without this the pool leaks one slot
+  // per in-flight frame at Stop time and the renderer eventually
+  // refuses to allocate new buffers.
+  //
+  // TODO(M2-R5-callbacks-map): assumes R3 stores Done callbacks as
+  // `mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>`
+  // keyed by buffer_id. If R3 keeps them as `mojo::PendingRemote`s
+  // bound only at consume time, this loop becomes a `Bind()+->Done()`
+  // pair instead.
+  for (auto& entry : in_flight_done_callbacks_) {
+    if (entry.second.is_bound() && entry.second.is_connected()) {
+      entry.second->Done();
+    }
+  }
+  in_flight_done_callbacks_.clear();
+}
