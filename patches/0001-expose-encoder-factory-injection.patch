From d254c97479a14a02f0f0d5ea6694a1d4e7966156 Mon Sep 17 00:00:00 2001
From: Iggy <iggy@triform.ai>
Date: Fri, 1 May 2026 06:16:09 +0200
Subject: [PATCH] cloud-browser: expose embedder hook for WebRTC video encoder
 factory
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds a virtual on content::ContentBrowserClient that lets an embedder
return a webrtc::VideoEncoderFactory; blink::PeerConnectionDependency
Factory consults a CONTENT_EXPORT wrapper that funnels into it.

Why this patch exists:
- Our cloud-browser worker (//cloud-browser/capture/build-integration/
  BUILD.gn) needs to plug CloudBrowserVideoEncoderFactory into the
  libwebrtc PeerConnectionFactory used inside Chromium.
- Chromium does not currently surface the
  PeerConnectionFactoryDependencies::video_encoder_factory slot to
  embedders; the blink-side factory bootstrap owns the assignment
  internally.
- A virtual on ContentBrowserClient is the standard Chromium shape
  for 'let embedders override this single decision.'

Why a free-function wrapper:
- content::GetContentClient() is gated on #if defined(CONTENT_IMPLEMENTATION)
  in content/public/common/content_client.h — it is intentionally
  not visible to code outside the content library. Blink lives in
  its own DSO.
- Adding GetEmbedderWebRtcVideoEncoderFactory() as a CONTENT_EXPORT
  free function in content/public/browser/content_browser_client.h
  (with implementation in the .cc, where CONTENT_IMPLEMENTATION IS
  defined) gives blink a stable, exported call site without having
  to widen the visibility of GetContentClient itself.

Touched files:
- content/public/browser/content_browser_client.h    (forward decl,
                                                       virtual on the
                                                       class, free
                                                       function decl)
- content/public/browser/content_browser_client.cc   (default virtual,
                                                       free function
                                                       implementation,
                                                       content_client.h
                                                       include)
- third_party/blink/renderer/modules/peerconnection/
    peer_connection_dependency_factory.cc            (consumer site
                                                       calls the
                                                       wrapper)

Resolved against branch-heads/7727 (Chromium 147 stable).
---
 .../public/browser/content_browser_client.cc  | 23 +++++++++++++++++++
 .../public/browser/content_browser_client.h   | 19 +++++++++++++++
 .../peer_connection_dependency_factory.cc     |  9 ++++++++
 3 files changed, 51 insertions(+)

diff --git a/content/public/browser/content_browser_client.cc b/content/public/browser/content_browser_client.cc
index d2dccc29b0..5c72f6a34e 100644
--- a/content/public/browser/content_browser_client.cc
+++ b/content/public/browser/content_browser_client.cc
@@ -58,6 +58,8 @@
 #include "content/public/browser/web_contents_view_delegate.h"
 #include "content/public/browser/webid/identity_request_dialog_controller.h"
 #include "content/public/common/alternative_error_page_override_info.mojom.h"
+#include "content/public/common/content_client.h"
 #include "content/public/common/content_features.h"
 #include "content/public/common/url_utils.h"
 #include "media/audio/audio_manager.h"
+#include "third_party/webrtc/api/video_codecs/video_encoder_factory.h"
@@ -953,6 +955,28 @@ std::optional<base::FilePath> ContentBrowserClient::GetLocalTracesDirectory() {
   return std::nullopt;
 }
 
+std::unique_ptr<webrtc::VideoEncoderFactory>
+ContentBrowserClient::GetWebRtcVideoEncoderFactory() {
+  return nullptr;
+}
+
+std::unique_ptr<webrtc::VideoEncoderFactory>
+GetEmbedderWebRtcVideoEncoderFactory() {
+  // GetContentClient() is a content-internal accessor; this wrapper lives
+  // inside the content library (CONTENT_IMPLEMENTATION is defined here),
+  // so it can legitimately use it. Callers in blink/ go through this
+  // function instead of touching the internal accessor directly.
+  ContentClient* content_client = GetContentClient();
+  if (!content_client) {
+    return nullptr;
+  }
+  ContentBrowserClient* browser_client = content_client->browser();
+  if (!browser_client) {
+    return nullptr;
+  }
+  return browser_client->GetWebRtcVideoEncoderFactory();
+}
+
 std::unique_ptr<ui::SelectFilePolicy>
 ContentBrowserClient::CreateSelectFilePolicy(WebContents* web_contents) {
   return nullptr;
diff --git a/content/public/browser/content_browser_client.h b/content/public/browser/content_browser_client.h
index 3b6c42b2c4..9052f617e1 100644
--- a/content/public/browser/content_browser_client.h
+++ b/content/public/browser/content_browser_client.h
@@ -177,6 +177,10 @@ class URLLoaderClient;
 }  // namespace mojom
 }  // namespace network
 
+namespace webrtc {
+class VideoEncoderFactory;
+}  // namespace webrtc
+
 namespace optimization_guide {
 class ModelBrokerClient;
 }  // namespace optimization_guide
@@ -1571,6 +1575,12 @@ class CONTENT_EXPORT ContentBrowserClient {
   // Returns the path to Local Traces directory.
   virtual std::optional<base::FilePath> GetLocalTracesDirectory();
 
+  // Returns an embedder-supplied webrtc::VideoEncoderFactory for use in
+  // PeerConnection construction, or nullptr to keep Chromium's built-in
+  // factory. Default returns nullptr.
+  virtual std::unique_ptr<webrtc::VideoEncoderFactory>
+  GetWebRtcVideoEncoderFactory();
+
   // Returns an implementation of a file selecition policy. Can return null.
   virtual std::unique_ptr<ui::SelectFilePolicy> CreateSelectFilePolicy(
       WebContents* web_contents);
@@ -3450,6 +3460,15 @@ class CONTENT_EXPORT ContentBrowserClient {
       const url::Origin& origin);
 };
 
+// Returns an embedder-supplied webrtc::VideoEncoderFactory by consulting
+// the active ContentBrowserClient (via the content-internal client
+// accessor). Lives in content/public/browser so blink/* can call it
+// without depending on the content-private GetContentClient(). Returns
+// nullptr if no embedder is installed or the embedder does not override
+// ContentBrowserClient::GetWebRtcVideoEncoderFactory.
+CONTENT_EXPORT std::unique_ptr<webrtc::VideoEncoderFactory>
+GetEmbedderWebRtcVideoEncoderFactory();
+
 }  // namespace content
 
 #endif  // CONTENT_PUBLIC_BROWSER_CONTENT_BROWSER_CLIENT_H_
diff --git a/third_party/blink/renderer/modules/peerconnection/peer_connection_dependency_factory.cc b/third_party/blink/renderer/modules/peerconnection/peer_connection_dependency_factory.cc
index fdb1d8a50e..613863b7ff 100644
--- a/third_party/blink/renderer/modules/peerconnection/peer_connection_dependency_factory.cc
+++ b/third_party/blink/renderer/modules/peerconnection/peer_connection_dependency_factory.cc
@@ -29,6 +29,7 @@
 #include "base/unguessable_token.h"
 #include "build/build_config.h"
 #include "components/webrtc/thread_wrapper.h"
+#include "content/public/browser/content_browser_client.h"
 #include "crypto/openssl_util.h"
 #include "media/base/media_permission.h"
 #include "media/media_buildflags.h"
@@ -950,6 +951,14 @@ void PeerConnectionDependencyFactory::InitializeSignalingThread(
   pcf_deps.video_encoder_factory = std::move(webrtc_encoder_factory);
   pcf_deps.video_decoder_factory = std::move(webrtc_decoder_factory);
 
+  // Cloud-browser hook: let the embedder override the encoder factory.
+  // Calls a CONTENT_EXPORT wrapper rather than the content-internal
+  // GetContentClient() accessor (which is gated on
+  // CONTENT_IMPLEMENTATION and not visible to blink).
+  if (auto encoder_factory = content::GetEmbedderWebRtcVideoEncoderFactory()) {
+    pcf_deps.video_encoder_factory = std::move(encoder_factory);
+  }
+
   // Audio Processing Module (APM) instances are owned and handled by the Blink
   // media stream module.
   DCHECK_EQ(pcf_deps.audio_processing_builder, nullptr);
-- 
