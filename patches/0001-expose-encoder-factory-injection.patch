 content/public/browser/content_browser_client.cc          |  4 ++++
 content/public/browser/content_browser_client.h           | 21 +++++++++++++++++++++
 .../peer_connection_dependency_factory.cc                 |  9 +++++++++
 3 files changed, 34 insertions(+)

diff --git a/content/public/browser/content_browser_client.h b/content/public/browser/content_browser_client.h
index aaaaaaaaaaaa..bbbbbbbbbbbb 100644
--- a/content/public/browser/content_browser_client.h
+++ b/content/public/browser/content_browser_client.h
@@ -50,6 +50,12 @@ namespace storage {
 class FileSystemBackend;
 }  // namespace storage

+namespace webrtc {
+// Forward-declared so this header doesn't pull in libwebrtc just for
+// one virtual.
+class VideoEncoderFactory;
+}  // namespace webrtc
+
 namespace content {

 class BrowserChildProcessHost;
@@ -1234,6 +1240,21 @@ class CONTENT_EXPORT ContentBrowserClient {
   // is one. Returning nullptr falls through to the default behavior.
   virtual std::optional<base::FilePath> GetLocalTracesDirectory();

+  // Cloud-browser hook (patches/0001-expose-encoder-factory-injection.patch).
+  //
+  // Returns an embedder-supplied webrtc::VideoEncoderFactory if one is
+  // installed, or nullptr to keep Chromium's built-in factory.
+  //
+  // Called once during PeerConnectionFactory construction. The
+  // returned factory becomes the PeerConnectionFactoryDependencies::
+  // video_encoder_factory for every PeerConnection in the process.
+  // Implementations MUST be thread-safe and MUST return a fresh
+  // instance each call (libwebrtc takes ownership).
+  //
+  // Default returns nullptr.
+  virtual std::unique_ptr<webrtc::VideoEncoderFactory>
+      GetWebRtcVideoEncoderFactory();
+
  protected:
   ~ContentBrowserClient() override = default;
 };
diff --git a/content/public/browser/content_browser_client.cc b/content/public/browser/content_browser_client.cc
index cccccccccccc..dddddddddddd 100644
--- a/content/public/browser/content_browser_client.cc
+++ b/content/public/browser/content_browser_client.cc
@@ -1500,4 +1500,8 @@ std::optional<base::FilePath> ContentBrowserClient::GetLocalTracesDirectory() {
   return std::nullopt;
 }

+std::unique_ptr<webrtc::VideoEncoderFactory>
+ContentBrowserClient::GetWebRtcVideoEncoderFactory() {
+  return nullptr;
+}
 }  // namespace content
diff --git a/third_party/blink/renderer/modules/peerconnection/peer_connection_dependency_factory.cc b/third_party/blink/renderer/modules/peerconnection/peer_connection_dependency_factory.cc
index eeeeeeeeeeee..ffffffffffff 100644
--- a/third_party/blink/renderer/modules/peerconnection/peer_connection_dependency_factory.cc
+++ b/third_party/blink/renderer/modules/peerconnection/peer_connection_dependency_factory.cc
@@ -440,6 +440,15 @@ void PeerConnectionDependencyFactory::CreatePeerConnectionFactory() {
   webrtc::PeerConnectionFactoryDependencies pcf_deps;
   // ... existing population of pcf_deps ...

+  // Cloud-browser hook: let the embedder override the encoder factory
+  // before we hand pcf_deps to libwebrtc. Patch
+  // patches/0001-expose-encoder-factory-injection.patch.
+  if (auto* client = content::GetContentClient()->browser()) {
+    if (auto encoder_factory = client->GetWebRtcVideoEncoderFactory()) {
+      pcf_deps.video_encoder_factory = std::move(encoder_factory);
+    }
+  }
+
   pc_factory_ = webrtc::CreateModularPeerConnectionFactory(std::move(pcf_deps));
   // ... existing post-construction wiring ...
 }
